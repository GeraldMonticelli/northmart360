        :minor,
        :minor-person-gen,
        :organization,
        :organization-customer,
        :organization-customer-customer-gen,
        :organization-customer-organization-gen,
        :person,
        :person-customer,
        :person-customer-customer-gen,
        :person-customer-person-gen ;
