:adult-person-gen a ontouml:Generalization ;
    ontouml:general :person ;
    ontouml:project :northmart-semantic-poc ;
    ontouml:specific :adult .

:card-card-holding-end_cardinality a ontouml:Cardinality ;
    ontouml:cardinalityValue "0..*" ;
    ontouml:lowerBound "0"^^xsd:nonNegativeInteger ;
    ontouml:upperBound "*" .

:card-holding-card-end_cardinality a ontouml:Cardinality ;
    ontouml:cardinalityValue "1..1" ;
    ontouml:lowerBound "1"^^xsd:nonNegativeInteger ;
    ontouml:upperBound "1" .

:card-holding-card-mediation a ontouml:Relation ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:name "card participation" ;
    ontouml:project :northmart-semantic-poc ;
    ontouml:relationEnd :card-card-holding-end,
        :card-holding-card-end ;
    ontouml:sourceEnd :card-holding-card-end ;
    ontouml:stereotype ontouml:mediation ;
    ontouml:targetEnd :card-card-holding-end .

