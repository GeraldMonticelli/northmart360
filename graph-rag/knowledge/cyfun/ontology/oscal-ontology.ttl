    rdfs:range xsd:string .

oscal:with-id a owl:DatatypeProperty ;
    rdfs:label "Match Controls by Identifier" ;
    rdfs:comment "Selecting a control by its ID given as a literal." ;
    rdfs:domain oscal:SelectControlById ;
    rdfs:range xsd:token .

oscal:IncludeAll a owl:Class ;
    rdfs:label "Include All" ;
    rdfs:comment "Include all controls from the imported catalog or profile resources." .

oscal:ParameterGuideline a owl:Class ;
    rdfs:label "Guideline" ;
    rdfs:comment "A prose statement that provides a recommendation for the use of a parameter." .

oscal:SecurityImpactLevel a owl:Class ;
    rdfs:label "Security Impact Level" ;
    rdfs:comment "The overall level of expected impact resulting from unauthorized disclosure, modification, or loss of access to information." .

oscal:AuthorizedPrivilege a owl:Class ;
    rdfs:label "Privilege" ;
    rdfs:comment "Identifies a specific system privilege held by the user, along with an associated description and/or rationale for the privilege." .

oscal:ConfidenceScore a owl:Class ;
    rdfs:label "Confidence Score" ;
    rdfs:comment "This records either a string category or a decimal value from 0-1 representing a percentage. Both of these values describe an estimation of the author's confidence that this mapping is correct and accurate." .

oscal:IncorporatesComponent a owl:Class ;
    rdfs:label "Incorporates Component" ;
    rdfs:comment "The collection of components comprising this capability." .

oscal:ParameterConstraint a owl:Class ;
    rdfs:label "Constraint" ;
    rdfs:comment "A formal or informal expression of a constraint or test." .

oscal:ParameterSelection a owl:Class ;
    rdfs:label "Selection" ;
    rdfs:comment "Presenting a choice among alternatives." .

oscal:Address a owl:Class ;
    rdfs:label "Address" ;
    rdfs:comment "A postal address for the location." .

oscal:AssociatedRisk a owl:Class ;
    rdfs:label "Associated Risk" ;
    rdfs:comment "Relates the finding to a set of referenced risks that were used to determine the finding." .

oscal:GapSummary a owl:Class ;
    rdfs:label "Gap Summary" ;
    rdfs:comment "A by-id collection of all controls that were not mapped at all in this mapping-collection. If a control is partially mapped, the parts of the control are not mappable, the gap and discrepancies should be documented in the relationship-gal." .

oscal:ImplementationStatus a owl:Class ;
    rdfs:label "Implementation Status" ;
    rdfs:comment "Indicates the degree to which the a given control is implemented." .

oscal:ImportAp a owl:Class ;
    rdfs:label "Import Assessment Plan" ;
    rdfs:comment "Used by assessment-results to import information about the original plan for assessing the system." .

oscal:ImportComponentDefinition a owl:Class ;
    rdfs:label "Import Component Definition" ;
    rdfs:comment "Loads a component definition from another resource." .

oscal:ImportProfile a owl:Class ;
    rdfs:label "Import Profile" ;
    rdfs:comment "Used to import the OSCAL profile representing the system's control baseline." .

oscal:ImportSsp a owl:Class ;
    rdfs:label "Import System Security Plan" ;
    rdfs:comment "Used by the assessment plan and POA&M to import information about the system." .

oscal:Matching a owl:Class ;
    rdfs:label "Match Controls by Pattern" ;
    rdfs:comment "Selecting a set of controls by matching their IDs with a wildcard pattern." .

oscal:Merge a owl:Class ;
    rdfs:label "Merge Controls" ;
    rdfs:comment "Provides structuring directives that instruct how controls are organized after profile resolution." .

oscal:Origin a owl:Class ;
    rdfs:label "Origin" ;
    rdfs:comment "Identifies the source of the finding, such as a tool, interviewed person, or activity." .

oscal:RelatedObservation a owl:Class ;
    rdfs:label "Related Observation" ;
    rdfs:comment "Relates the identified element to a set of referenced observations that were used to support its determination." .

oscal:SelectObjectiveById a owl:Class ;
    rdfs:label "Select Objective" ;
    rdfs:comment "Used to select a control objective for inclusion/exclusion based on the control objective's identifier." .

oscal:SetParameter a owl:Class ;
    rdfs:label "Set Parameter Value" ;
    rdfs:comment "Identifies the parameter that will be set by the enclosed value." .

oscal:Status a owl:Class ;
    rdfs:label "Status" ;
    rdfs:comment "Describes the operational status of the system." .

oscal:AssessmentSubjectPlaceholder a owl:Class ;
    rdfs:label "Assessment Subject Placeholder" ;
    rdfs:comment "Used when the assessment subjects will be determined as part of one or more other assessment activities. These assessment subjects will be recorded in the assessment results in the assessment log." .

oscal:Import a owl:Class ;
    rdfs:label "Import Resource" ;
    rdfs:comment "Designates a referenced source catalog or profile that provides a source of control information for use in creating a new overlay or baseline." .

oscal:InsertControls a owl:Class ;
    rdfs:label "Insert Controls" ;
    rdfs:comment "Specifies which controls to use in the containing context." .

oscal:LoggedBy a owl:Class ;
    rdfs:label "Logged By" ;
    rdfs:comment "Used to indicate who created a log entry in what role." .

oscal:Protocol a owl:Class ;
    rdfs:label "Service Protocol Information" ;
    rdfs:comment "Information about the protocol used to provide a service." .

oscal:SelectControlById a owl:Class ;
    rdfs:label "Select Control" ;
    rdfs:comment "Select a control or controls from an imported control set." .

oscal:SystemInformation a owl:Class ;
    rdfs:label "System Information" ;
    rdfs:comment "Contains details about all information types that are stored, processed, or transmitted by the system, such as privacy information, and those defined in NIST SP 800-60." .

oscal:AssessmentMethod a owl:Class ;
    rdfs:label "Assessment Method" ;
    rdfs:comment "A local definition of a control objective. Uses catalog syntax for control objective and assessment activities." .

oscal:AuthorizationBoundary a owl:Class ;
    rdfs:label "Authorization Boundary" ;
    rdfs:comment "A description of this system's authorization boundary, optionally supplemented by diagrams that illustrate the authorization boundary." .

oscal:Characterization a owl:Class ;
    rdfs:label "Characterization" ;
    rdfs:comment "A collection of descriptive data about the containing object from a specific origin." .

oscal:DataFlow a owl:Class ;
    rdfs:label "Data Flow" ;
    rdfs:comment "A description of the logical flow of information within the system and across its boundaries, optionally supplemented by diagrams that illustrate these flows." .

oscal:Diagram a owl:Class ;
    rdfs:label "Diagram" ;
    rdfs:comment "A graphic that provides a visual representation the system, or some aspect of it." .

oscal:Link a owl:Class ;
    rdfs:label "Link" ;
    rdfs:comment "A reference to a local or remote resource, that has a specific relation to the containing object." .

oscal:LocalDefinitions a owl:Class ;
    rdfs:label "Local Definitions" ;
    rdfs:comment "Allows components, and inventory-items to be defined within the POA&M for circumstances where no OSCAL-based SSP exists, or is not delivered with the POA&M." .

oscal:MappingCollection a owl:Class ;
    rdfs:label "Mapping Collection" ;
    rdfs:comment "A collection of relationship-based control and/or control statement mappings." .

oscal:NetworkArchitecture a owl:Class ;
    rdfs:label "Network Architecture" ;
    rdfs:comment "A description of the system's network architecture, optionally supplemented by diagrams that illustrate the network architecture." .

oscal:PortRange a owl:Class ;
    rdfs:label "Port Range" ;
    rdfs:comment "Where applicable this is the transport layer protocol port range an IPv4-based or IPv6-based service uses." .

oscal:QualifierItem a owl:Class ;
    rdfs:label "Relationship Qualifier" ;
    rdfs:comment "Describes requirements, incompatibilities and gaps that are identified between a target and source in a mapping item." .

oscal:AssessmentAssets a owl:Class ;
    rdfs:label "Assessment Assets" ;
    rdfs:comment "Identifies the assets used to perform this assessment, such as the assessment team, scanning tools, and assumptions." .

oscal:BackMatter a owl:Class ;
    rdfs:label "Back matter" ;
    rdfs:comment "A collection of resources that may be referenced from within the OSCAL document instance." .

oscal:Catalog a owl:Class ;
    rdfs:label "Catalog" ;
    rdfs:comment "A structured, organized collection of control information." .

oscal:ComponentDefinition a owl:Class ;
    rdfs:label "Component Definition" ;
    rdfs:comment "A collection of component descriptions, which may optionally be grouped by capability." .

oscal:Impact a owl:Class ;
    rdfs:label "Impact Level" ;
    rdfs:comment "The expected level of impact resulting from the described information." .

oscal:InventoryItem a owl:Class ;
    rdfs:label "Inventory Item" ;
    rdfs:comment "A single managed inventory item within the system." .

oscal:LocalObjective a owl:Class ;
    rdfs:label "Assessment-Specific Control Objective" ;
    rdfs:comment "A local definition of a control objective for this assessment. Uses catalog syntax for control objective and assessment actions." .

oscal:MappingItem a owl:Class ;
    rdfs:label "Mapping Entry Item (source or target)" ;
    rdfs:comment "A specific edge within a source or target that is the subject of a mapping." .

oscal:OriginActor a owl:Class ;
    rdfs:label "Originating Actor" ;
    rdfs:comment "The actor that produces an observation, a finding, or a risk. One or more actor type can be used to specify a person that is using a tool." .

oscal:Profile a owl:Class ;
    rdfs:label "Profile" ;
    rdfs:comment "Each OSCAL profile is defined by a profile element." .

oscal:ResponsibleParty a owl:Class ;
    rdfs:label "Responsible Party" ;
    rdfs:comment "A reference to a set of persons and/or organizations that have responsibility for performing the referenced role in the context of the containing object." .

oscal:ResponsibleRole a owl:Class ;
    rdfs:label "Responsible Role" ;
    rdfs:comment "A reference to a role with responsibility for performing a function relative to the containing object, optionally associated with a set of persons and/or organizations that perform that role." .

oscal:SelectSubjectById a owl:Class ;
    rdfs:label "Select Assessment Subject" ;
    rdfs:comment "Identifies a set of assessment subjects to include/exclude by UUID." .

oscal:SubjectReference a owl:Class ;
    rdfs:label "Identifies the Subject" ;
    rdfs:comment "A human-oriented identifier reference to a resource. Use type to indicate whether the identified resource is a component, inventory item, location, user, or something else." .

oscal:Activity a owl:Class ;
    rdfs:label "Activity" ;
    rdfs:comment "Identifies an assessment or related process that can be performed. In the assessment plan, this is an intended activity which may be associated with an assessment task. In the assessment results, this an activity that was actually performed as part of an assessment." .

oscal:AssessmentSubject a owl:Class ;
    rdfs:label "Subject of Assessment" ;
    rdfs:comment "Identifies system elements being assessed, such as components, inventory items, and locations. In the assessment plan, this identifies a planned assessment subject. In the assessment results this is an actual assessment subject, and reflects any changes from the plan. exactly what will be the focus of this assessment. Any subjects not identified in this way are out-of-scope." .

oscal:ControlImplementation a owl:Class ;
    rdfs:label "Control Implementation Set" ;
    rdfs:comment "Defines how the component or capability supports a set of controls." .

oscal:FindingTarget a owl:Class ;
    rdfs:label "Objective Status" ;
    rdfs:comment "Captures an assessor's conclusions regarding the degree to which an objective is satisfied." .

oscal:MappingResourceReference a owl:Class ;
    rdfs:label "Mapped Resource Reference" ;
    rdfs:comment "A reference to a resource that is either the source or the target of a mapping." .

oscal:Observation a owl:Class ;
    rdfs:label "Observation" ;
    rdfs:comment "Describes an individual observation." .

oscal:RelatedTask a owl:Class ;
    rdfs:label "Task Reference" ;
    rdfs:comment "Identifies an individual task for which the containing object is a consequence of." .

oscal:ReviewedControls a owl:Class ;
    rdfs:label "Reviewed Controls and Control Objectives" ;
    rdfs:comment "Identifies the controls being assessed and their control objectives." .

oscal:Statement a owl:Class ;
    rdfs:label "Control Statement Implementation" ;
    rdfs:comment "Identifies which statements within a control are addressed." .

oscal:SystemSecurityPlan a owl:Class ;
    rdfs:label "System Security Plan (SSP)" ;
    rdfs:comment "A system security plan, such as those described in NIST SP 800-18." .

oscal:SystemUser a owl:Class ;
    rdfs:label "System User" ;
    rdfs:comment "A type of user that interacts with the system based on an associated role." .

oscal:AssessmentPart a owl:Class ;
    rdfs:label "Assessment Part" ;
    rdfs:comment "A partition of an assessment plan or results or a child of another part." .

oscal:AssessmentResults a owl:Class ;
    rdfs:label "Security Assessment Results (SAR)" ;
    rdfs:comment "Security assessment results, such as those provided by a FedRAMP assessor in the FedRAMP Security Assessment Report." .

oscal:ByComponent a owl:Class ;
    rdfs:label "Component Control Implementation" ;
    rdfs:comment "Defines how the referenced component implements a set of controls." .

oscal:Capability a owl:Class ;
    rdfs:label "Capability" ;
    rdfs:comment "A grouping of other components and/or capabilities." .

oscal:Control a owl:Class ;
    rdfs:label "Control" ;
    rdfs:comment "A structured object representing a requirement or guideline, which when implemented will reduce an aspect of risk related to an information system and its information." .

oscal:Part a owl:Class ;
    rdfs:label "Part" ;
    rdfs:comment "An annotated, markup-based textual element of a control's or catalog group's definition, or a child of another part." .

oscal:PoamItem a owl:Class ;
    rdfs:label "POA&M Item" ;
    rdfs:comment "Describes an individual POA&M item." .

oscal:Property a owl:Class ;
    rdfs:label "Property" ;
    rdfs:comment "An attribute, characteristic, or quality of the containing object expressed as a namespace qualified name/value pair." .

oscal:SystemComponent a owl:Class ;
    rdfs:label "Component" ;
    rdfs:comment "A defined component that can be part of an implemented system." .

oscal:SystemImplementation a owl:Class ;
    rdfs:label "System Implementation" ;
    rdfs:comment "Provides information as to how the system is implemented." .

oscal:Action a owl:Class ;
    rdfs:label "Action" ;
    rdfs:comment "An action applied by a role within a given party to the content." .

oscal:DefinedComponent a owl:Class ;
    rdfs:label "Component" ;
    rdfs:comment "A defined component that can be part of an implemented system." .

oscal:Finding a owl:Class ;
    rdfs:label "Finding" ;
    rdfs:comment "Describes an individual finding." .

oscal:Group a owl:Class ;
    rdfs:label "Control Group" ;
    rdfs:comment "A group of controls, or of groups of controls." .

oscal:ImplementedRequirement a owl:Class ;
    rdfs:label "Control Implementation" ;
    rdfs:comment "Describes how the containing component or capability implements an individual control." .

oscal:Response a owl:Class ;
    rdfs:label "Risk Response" ;
    rdfs:comment "Describes either recommended or an actual plan for addressing the risk." .

oscal:Task a owl:Class ;
    rdfs:label "Task" ;
    rdfs:comment "Represents a scheduled event or milestone, which may be associated with a series of assessment actions." .

oscal:Modify a owl:Class ;
    rdfs:label "Modify Controls" ;
    rdfs:comment "Set parameters or amend controls in resolution." .

oscal:PlanOfActionAndMilestones a owl:Class ;
    rdfs:label "Plan of Action and Milestones (POA&M)" ;
    rdfs:comment "A plan of action and milestones which identifies initial and residual risks, deviations, and disposition, such as those required by FedRAMP." .

oscal:Map a owl:Class ;
    rdfs:label "Mapping Entry" ;
    rdfs:comment "A relationship-based mapping between a source and target set consisting of members (i.e., controls, control statements) from the respective source and target." .

oscal:MappingProvenance a owl:Class ;
    rdfs:label "Mapping Provenance" ;
    rdfs:comment "Describes requirements, incompatibilities and gaps that are identified between a target and source in a mapping item." .

oscal:Parameter a owl:Class ;
    rdfs:label "Parameter" ;
    rdfs:comment "Parameters provide a mechanism for the dynamic assignment of value(s) in a control." .

oscal:SystemCharacteristics a owl:Class ;
    rdfs:label "System Characteristics" ;
    rdfs:comment "Contains the characteristics of the system, such as its name, purpose, and security impact level." .

oscal:Mapping a owl:Class ;
    rdfs:label "Control Mapping" ;
    rdfs:comment "A mapping between two target resources." .

oscal:Risk a owl:Class ;
    rdfs:label "Identified Risk" ;
    rdfs:comment "An identified risk." .

oscal:AssessmentPlan a owl:Class ;
    rdfs:label "Security Assessment Plan (SAP)" ;
    rdfs:comment "An assessment plan, such as those provided by a FedRAMP assessor." .

oscal:Metadata a owl:Class ;
    rdfs:label "Document Metadata" ;
    rdfs:comment "Provides information about the containing document, and defines concepts that are shared across the document." .

oscal:Result a owl:Class ;
    rdfs:label "Assessment Result" ;
    rdfs:comment "Used by the assessment results and POA&M. In the assessment results, this identifies all of the assessment observations and findings, initial and residual risks, deviations, and disposition. In the POA&M, this identifies initial and residual risks, deviations, and disposition." .

