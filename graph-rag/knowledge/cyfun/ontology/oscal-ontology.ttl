@prefix oscal: <https://csrc.nist.gov/ns/oscal/semantic/1.0#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oscal:Ontology a owl:Ontology ;
    rdfs:label "OSCAL semantic projection generated from NIST Metaschema" .

oscal:action a owl:ObjectProperty ;
    rdfs:label "action" ;
    rdfs:domain oscal:Metadata ;
    rdfs:range oscal:Action .

oscal:activity a owl:ObjectProperty ;
    rdfs:label "activity" ;
    rdfs:domain oscal:AssessmentPlan,
        oscal:AssessmentResults ;
    rdfs:range oscal:Activity .

oscal:actor-uuid a owl:DatatypeProperty ;
    rdfs:label "Actor Universally Unique Identifier Reference" ;
    rdfs:comment "A machine-oriented identifier reference to the tool or person based on the associated type." ;
    rdfs:domain oscal:OriginActor ;
    rdfs:range xsd:string .

oscal:addr-line a owl:DatatypeProperty ;
    rdfs:label "Address line" ;
    rdfs:comment "A single line of an address." ;
    rdfs:domain oscal:Address ;
    rdfs:range xsd:string .

oscal:address a owl:ObjectProperty ;
    rdfs:label "address" ;
    rdfs:domain oscal:Metadata ;
    rdfs:range oscal:Address .

oscal:adjustment-justification a owl:DatatypeProperty ;
    rdfs:label "Adjustment Justification" ;
    rdfs:comment "If the selected security level is different from the base security level, this contains the justification for the change." ;
    rdfs:domain oscal:Impact ;
    rdfs:range rdf:HTML .

oscal:assessment-assets a owl:ObjectProperty ;
    rdfs:label "assessment-assets" ;
    rdfs:domain oscal:AssessmentPlan,
        oscal:LocalDefinitions,
        oscal:Result ;
    rdfs:range oscal:AssessmentAssets .

oscal:assessment-part a owl:ObjectProperty ;
    rdfs:label "assessment-part" ;
    rdfs:domain oscal:AssessmentMethod,
        oscal:AssessmentPart,
        oscal:AssessmentPlan,
        oscal:Result ;
    rdfs:range oscal:AssessmentPart .

oscal:assessment-subject a owl:ObjectProperty ;
    rdfs:label "assessment-subject" ;
    rdfs:domain oscal:AssessmentPlan,
        oscal:RelatedTask,
        oscal:Task ;
    rdfs:range oscal:AssessmentSubject .

oscal:associated-risk a owl:ObjectProperty ;
    rdfs:label "associated-risk" ;
    rdfs:domain oscal:Finding,
        oscal:PoamItem ;
    rdfs:range oscal:AssociatedRisk .

oscal:authorization-boundary a owl:ObjectProperty ;
    rdfs:label "authorization-boundary" ;
    rdfs:domain oscal:SystemCharacteristics ;
    rdfs:range oscal:AuthorizationBoundary .

oscal:authorized-privilege a owl:ObjectProperty ;
    rdfs:label "authorized-privilege" ;
    rdfs:domain oscal:SystemUser ;
    rdfs:range oscal:AuthorizedPrivilege .

oscal:back-matter a owl:ObjectProperty ;
    rdfs:label "back-matter" ;
    rdfs:domain oscal:AssessmentPlan,
        oscal:AssessmentResults,
        oscal:Catalog,
        oscal:ComponentDefinition,
        oscal:MappingCollection,
        oscal:PlanOfActionAndMilestones,
        oscal:Profile,
        oscal:SystemSecurityPlan ;
    rdfs:range oscal:BackMatter .

oscal:base a owl:DatatypeProperty ;
    rdfs:label "Base Level (Confidentiality, Integrity, or Availability)" ;
    rdfs:comment "The prescribed base (Confidentiality, Integrity, or Availability) security impact level." ;
    rdfs:domain oscal:Impact ;
    rdfs:range xsd:string .

oscal:capability a owl:ObjectProperty ;
    rdfs:label "capability" ;
    rdfs:domain oscal:ComponentDefinition ;
    rdfs:range oscal:Capability .

oscal:category a owl:DatatypeProperty ;
    rdfs:label "Category" ;
    rdfs:comment "The category expresses the resolvable nature of the predicate." ;
    rdfs:domain oscal:QualifierItem ;
    rdfs:range xsd:string .

oscal:characterization a owl:ObjectProperty ;
    rdfs:label "characterization" ;
    rdfs:domain oscal:Risk ;
    rdfs:range oscal:Characterization .

oscal:class a owl:DatatypeProperty ;
    rdfs:label "Control Class",
        "Group Class",
        "Parameter Class",
        "Part Class",
        "Property Class" ;
    rdfs:comment "A textual label that provides a characterization of the type, purpose, use or scope of the parameter.",
        "A textual label that provides a sub-type or characterization of the control.",
        "A textual label that provides a sub-type or characterization of the group.",
        "A textual label that provides a sub-type or characterization of the part's name. This can be used to further distinguish or discriminate between the semantics of multiple parts of the same control with the same name and ns.",
        "A textual label that provides a sub-type or characterization of the property's name.",
        "An optional textual providing a sub-type or characterization of the part's name, or a category to which the part belongs." ;
    rdfs:domain oscal:AssessmentPart,
        oscal:Control,
        oscal:Group,
        oscal:Parameter,
        oscal:Part,
        oscal:Property ;
    rdfs:range xsd:token .

oscal:component-uuid a owl:DatatypeProperty ;
    rdfs:label "Component Reference",
        "Component Universally Unique Identifier Reference" ;
    rdfs:comment "A machine-oriented identifier reference to a component.",
        "A machine-oriented identifier reference to the component that is implementing a given control." ;
    rdfs:domain oscal:ByComponent,
        oscal:IncorporatesComponent ;
    rdfs:range xsd:string .

oscal:confidence-score a owl:ObjectProperty ;
    rdfs:label "confidence-score" ;
    rdfs:domain oscal:Map,
        oscal:Mapping,
        oscal:MappingProvenance ;
    rdfs:range oscal:ConfidenceScore .

oscal:control a owl:ObjectProperty ;
    rdfs:label "control" ;
    rdfs:domain oscal:Catalog,
        oscal:Control,
        oscal:Group ;
    rdfs:range oscal:Control .

oscal:control-id a owl:DatatypeProperty ;
    rdfs:label "control-id" ;
    rdfs:domain oscal:ImplementedRequirement,
        oscal:LocalObjective ;
    rdfs:range xsd:string .

oscal:control-implementation a owl:ObjectProperty ;
    rdfs:label "control-implementation" ;
    rdfs:domain oscal:Capability,
        oscal:DefinedComponent,
        oscal:SystemSecurityPlan ;
    rdfs:range oscal:ControlImplementation .

oscal:coverage a owl:DatatypeProperty ;
    rdfs:label "Coverage" ;
    rdfs:comment "A decimal value from 0-1, representing the percentage coverage of the targets by the sources." ;
    rdfs:domain oscal:Map,
        oscal:Mapping,
        oscal:MappingProvenance ;
    rdfs:range xsd:decimal .

oscal:data-flow a owl:ObjectProperty ;
    rdfs:label "data-flow" ;
    rdfs:domain oscal:SystemCharacteristics ;
    rdfs:range oscal:DataFlow .

oscal:date a owl:DatatypeProperty ;
    rdfs:label "Action Occurrence Date" ;
    rdfs:comment "The date and time when the action occurred." ;
    rdfs:domain oscal:Action ;
    rdfs:range xsd:dateTime .

oscal:date-authorized a owl:DatatypeProperty ;
    rdfs:label "System Authorization Date",
        "date-authorized" ;
    rdfs:comment "The date the system received its authorization." ;
    rdfs:domain oscal:SystemCharacteristics,
        oscal:SystemImplementation ;
    rdfs:range xsd:date .

oscal:defined-component a owl:ObjectProperty ;
    rdfs:label "defined-component" ;
    rdfs:domain oscal:ComponentDefinition ;
    rdfs:range oscal:DefinedComponent .

oscal:defined-component-type a owl:DatatypeProperty ;
    rdfs:label "defined-component-type" ;
    rdfs:domain oscal:DefinedComponent ;
    rdfs:range xsd:string .

oscal:depends-on a owl:DatatypeProperty ;
    rdfs:label "Depends on" ;
    rdfs:comment "(deprecated) Another parameter invoking this one. This construct has been deprecated and should not be used." ;
    rdfs:domain oscal:Parameter ;
    rdfs:range xsd:token .

oscal:diagram a owl:ObjectProperty ;
    rdfs:label "diagram" ;
    rdfs:domain oscal:AuthorizationBoundary,
        oscal:DataFlow,
        oscal:NetworkArchitecture ;
    rdfs:range oscal:Diagram .

oscal:document-id a owl:DatatypeProperty ;
    rdfs:label "Document Identifier",
        "document-id" ;
    rdfs:comment "A document identifier qualified by an identifier scheme." ;
    rdfs:domain oscal:BackMatter,
        oscal:Metadata ;
    rdfs:range xsd:string .

oscal:email-address a owl:DatatypeProperty ;
    rdfs:label "email-address" ;
    rdfs:domain oscal:Metadata ;
    rdfs:range xsd:string .

oscal:end a owl:DatatypeProperty ;
    rdfs:label "End" ;
    rdfs:comment "Indicates the ending port number in a port range for a transport layer protocol" ;
    rdfs:domain oscal:PortRange ;
    rdfs:range xsd:nonNegativeInteger .

oscal:finding a owl:ObjectProperty ;
    rdfs:label "finding" ;
    rdfs:domain oscal:PlanOfActionAndMilestones,
        oscal:Result ;
    rdfs:range oscal:Finding .

oscal:finding-target a owl:ObjectProperty ;
    rdfs:label "finding-target" ;
    rdfs:domain oscal:Finding ;
    rdfs:range oscal:FindingTarget .

oscal:function-performed a owl:DatatypeProperty ;
    rdfs:label "Functions Performed" ;
    rdfs:comment "Describes a function performed for a given authorized privilege by this user class." ;
    rdfs:domain oscal:AuthorizedPrivilege ;
    rdfs:range xsd:string .

oscal:gap-summary a owl:ObjectProperty ;
    rdfs:label "gap-summary" ;
    rdfs:domain oscal:Mapping ;
    rdfs:range oscal:GapSummary .

oscal:group a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "Property Group",
        "group" ;
    rdfs:comment "An identifier for relating distinct sets of properties." ;
    rdfs:domain oscal:Catalog,
        oscal:Group,
        oscal:Merge,
        oscal:Property ;
    rdfs:range xsd:token,
        oscal:Group .

oscal:hash a owl:DatatypeProperty ;
    rdfs:label "hash" ;
    rdfs:domain oscal:BackMatter ;
    rdfs:range xsd:string .

oscal:how-many a owl:DatatypeProperty ;
    rdfs:label "Parameter Cardinality" ;
    rdfs:comment "Describes the number of selections that must occur. Without this setting, only one value should be assumed to be permitted." ;
    rdfs:domain oscal:ParameterSelection ;
    rdfs:range xsd:token .

oscal:href a owl:DatatypeProperty ;
    rdfs:label "Assessment Plan Reference",
        "Catalog or Profile Reference",
        "Hyperlink Reference",
        "Hypertext Reference",
        "Profile Reference",
        "System Security Plan Reference" ;
    rdfs:comment "A link to a resource that defines a set of components and/or capabilities to import into this collection.",
        "A resolvable URL reference to a resource.",
        "A resolvable URL reference to the assessment plan governing the assessment activities.",
        "A resolvable URL reference to the base catalog or profile that this profile is tailoring.",
        "A resolvable URL reference to the profile or catalog to use as the system's control baseline.",
        "A resolvable URL reference to the system security plan for the system being assessed." ;
    rdfs:domain oscal:Import,
        oscal:ImportAp,
        oscal:ImportComponentDefinition,
        oscal:ImportProfile,
        oscal:ImportSsp,
        oscal:Link,
        oscal:MappingResourceReference ;
    rdfs:range xsd:anyURI .

oscal:id a owl:DatatypeProperty ;
    rdfs:label "Control Identifier",
        "Group Identifier",
        "Parameter Identifier",
        "Part Identifier" ;
    rdfs:comment "A unique identifier for the parameter.",
        "A unique identifier for the part.",
        "Identifies a control such that it can be referenced in the defining catalog and other OSCAL instances (e.g., profiles).",
        "Identifies the group for the purpose of cross-linking within the defining instance or from other instances that reference the catalog." ;
    rdfs:domain oscal:Control,
        oscal:Group,
        oscal:Parameter,
        oscal:Part ;
    rdfs:range xsd:token .

oscal:id-ref a owl:DatatypeProperty ;
    rdfs:label "Subject Identifier Reference" ;
    rdfs:comment "A reference to an identified subject that is of the specified type ." ;
    rdfs:domain oscal:MappingItem ;
    rdfs:range xsd:string .

oscal:impact a owl:ObjectProperty ;
    rdfs:label "impact" ;
    rdfs:domain oscal:SystemInformation ;
    rdfs:range oscal:Impact .

oscal:implementation-status a owl:ObjectProperty ;
    rdfs:label "implementation-status" ;
    rdfs:domain oscal:ByComponent,
        oscal:FindingTarget ;
    rdfs:range oscal:ImplementationStatus .

oscal:implemented-requirement a owl:ObjectProperty ;
    rdfs:label "implemented-requirement" ;
    rdfs:domain oscal:ControlImplementation ;
    rdfs:range oscal:ImplementedRequirement .

oscal:import a owl:ObjectProperty ;
    rdfs:label "import" ;
    rdfs:domain oscal:Profile ;
    rdfs:range oscal:Import .

oscal:import-ap a owl:ObjectProperty ;
    rdfs:label "import-ap" ;
    rdfs:domain oscal:AssessmentResults ;
    rdfs:range oscal:ImportAp .

oscal:import-component-definition a owl:ObjectProperty ;
    rdfs:label "import-component-definition" ;
    rdfs:domain oscal:ComponentDefinition ;
    rdfs:range oscal:ImportComponentDefinition .

oscal:import-profile a owl:ObjectProperty ;
    rdfs:label "import-profile" ;
    rdfs:domain oscal:SystemSecurityPlan ;
    rdfs:range oscal:ImportProfile .

oscal:import-ssp a owl:ObjectProperty ;
    rdfs:label "import-ssp" ;
    rdfs:domain oscal:AssessmentPlan,
        oscal:PlanOfActionAndMilestones ;
    rdfs:range oscal:ImportSsp .

oscal:include-all a owl:ObjectProperty ;
    rdfs:label "include-all" ;
    rdfs:domain oscal:AssessmentSubject,
        oscal:Import,
        oscal:InsertControls,
        oscal:ReviewedControls ;
    rdfs:range oscal:IncludeAll .

oscal:incorporates-component a owl:ObjectProperty ;
    rdfs:label "incorporates-component" ;
    rdfs:domain oscal:Capability ;
    rdfs:range oscal:IncorporatesComponent .

oscal:insert-controls a owl:ObjectProperty ;
    rdfs:label "insert-controls" ;
    rdfs:domain oscal:Merge ;
    rdfs:range oscal:InsertControls .

oscal:inventory-item a owl:ObjectProperty ;
    rdfs:label "inventory-item" ;
    rdfs:domain oscal:AssessmentPlan,
        oscal:LocalDefinitions,
        oscal:Result,
        oscal:SystemImplementation ;
    rdfs:range oscal:InventoryItem .

oscal:last-modified a owl:DatatypeProperty ;
    rdfs:label "Last Modified Timestamp",
        "last-modified" ;
    rdfs:comment "The date and time the document was last stored for later retrieval." ;
    rdfs:domain oscal:Metadata ;
    rdfs:range xsd:dateTime .

oscal:lifecycle a owl:DatatypeProperty ;
    rdfs:label "Remediation Intent" ;
    rdfs:comment "Identifies whether this is a recommendation, such as from an assessor or tool, or an actual plan accepted by the system owner." ;
    rdfs:domain oscal:Response ;
    rdfs:range xsd:token .

oscal:link a owl:ObjectProperty ;
    rdfs:label "link" ;
    rdfs:domain oscal:Action,
        oscal:Activity,
        oscal:AssessmentAssets,
        oscal:AssessmentMethod,
        oscal:AssessmentPart,
        oscal:AssessmentSubject,
        oscal:AssessmentSubjectPlaceholder,
        oscal:AuthorizationBoundary,
        oscal:BackMatter,
        oscal:ByComponent,
        oscal:Capability,
        oscal:Characterization,
        oscal:Control,
        oscal:ControlImplementation,
        oscal:DataFlow,
        oscal:DefinedComponent,
        oscal:Diagram,
        oscal:Finding,
        oscal:FindingTarget,
        oscal:Group,
        oscal:Impact,
        oscal:ImplementedRequirement,
        oscal:InventoryItem,
        oscal:LocalObjective,
        oscal:Map,
        oscal:Mapping,
        oscal:MappingItem,
        oscal:MappingProvenance,
        oscal:MappingResourceReference,
        oscal:Metadata,
        oscal:Modify,
        oscal:NetworkArchitecture,
        oscal:Observation,
        oscal:OriginActor,
        oscal:Parameter,
        oscal:Part,
        oscal:PoamItem,
        oscal:RelatedTask,
        oscal:Response,
        oscal:ResponsibleParty,
        oscal:ResponsibleRole,
        oscal:Result,
        oscal:ReviewedControls,
        oscal:Risk,
        oscal:SelectSubjectById,
        oscal:Statement,
        oscal:SubjectReference,
        oscal:SystemCharacteristics,
        oscal:SystemComponent,
        oscal:SystemImplementation,
        oscal:SystemInformation,
        oscal:SystemUser,
        oscal:Task ;
    rdfs:range oscal:Link .

oscal:local-definitions a owl:ObjectProperty ;
    rdfs:label "local-definitions" ;
    rdfs:domain oscal:PlanOfActionAndMilestones ;
    rdfs:range oscal:LocalDefinitions .

oscal:local-objective a owl:ObjectProperty ;
    rdfs:label "local-objective" ;
    rdfs:domain oscal:AssessmentPlan,
        oscal:AssessmentResults ;
    rdfs:range oscal:LocalObjective .

oscal:location-type a owl:DatatypeProperty ;
    rdfs:label "location-type" ;
    rdfs:domain oscal:Address ;
    rdfs:range xsd:string .

oscal:location-uuid a owl:DatatypeProperty ;
    rdfs:label "location-uuid" ;
    rdfs:domain oscal:Metadata ;
    rdfs:range xsd:string .

oscal:logged-by a owl:ObjectProperty ;
    rdfs:label "logged-by" ;
    rdfs:domain oscal:Result,
        oscal:Risk ;
    rdfs:range oscal:LoggedBy .

oscal:map a owl:ObjectProperty ;
    rdfs:label "map" ;
    rdfs:domain oscal:Mapping ;
    rdfs:range oscal:Map .

oscal:mapping a owl:ObjectProperty ;
    rdfs:label "mapping" ;
    rdfs:domain oscal:MappingCollection ;
    rdfs:range oscal:Mapping .

oscal:mapping-description a owl:DatatypeProperty ;
    rdfs:label "Mapping Description" ;
    rdfs:comment "Description of the context and intended use of the mapping set." ;
    rdfs:domain oscal:Mapping,
        oscal:MappingProvenance ;
    rdfs:range rdf:HTML .

oscal:mapping-item a owl:ObjectProperty ;
    rdfs:label "mapping-item" ;
    rdfs:domain oscal:Map ;
    rdfs:range oscal:MappingItem .

oscal:mapping-provenance a owl:ObjectProperty ;
    rdfs:label "mapping-provenance" ;
    rdfs:domain oscal:MappingCollection ;
    rdfs:range oscal:MappingProvenance .

oscal:mapping-resource-reference a owl:ObjectProperty ;
    rdfs:label "mapping-resource-reference" ;
    rdfs:domain oscal:Mapping ;
    rdfs:range oscal:MappingResourceReference .

oscal:matching a owl:ObjectProperty ;
    rdfs:label "matching" ;
    rdfs:domain oscal:SelectControlById ;
    rdfs:range oscal:Matching .

oscal:matching-rationale a owl:DatatypeProperty ;
    rdfs:label "matching-rationale" ;
    rdfs:domain oscal:Map,
        oscal:Mapping,
        oscal:MappingProvenance ;
    rdfs:range xsd:string .

oscal:media-type a owl:DatatypeProperty ;
    rdfs:label "media-type" ;
    rdfs:domain oscal:Link ;
    rdfs:range xsd:string .

oscal:merge a owl:ObjectProperty ;
    rdfs:label "merge" ;
    rdfs:domain oscal:Profile ;
    rdfs:range oscal:Merge .

oscal:metadata a owl:ObjectProperty ;
    rdfs:label "metadata" ;
    rdfs:domain oscal:AssessmentPlan,
        oscal:AssessmentResults,
        oscal:Catalog,
        oscal:ComponentDefinition,
        oscal:MappingCollection,
        oscal:PlanOfActionAndMilestones,
        oscal:Profile,
        oscal:SystemSecurityPlan ;
    rdfs:range oscal:Metadata .

oscal:method a owl:DatatypeProperty ;
    rdfs:label "method" ;
    rdfs:domain oscal:Mapping,
        oscal:MappingProvenance ;
    rdfs:range xsd:string .

oscal:modify a owl:ObjectProperty ;
    rdfs:label "modify" ;
    rdfs:domain oscal:Profile ;
    rdfs:range oscal:Modify .

oscal:name a owl:DatatypeProperty ;
    rdfs:label "Capability Name",
        "Part Name",
        "Property Name",
        "Protocol Name" ;
    rdfs:comment "A textual label that uniquely identifies the part's semantic type, which exists in a value space qualified by the ns.",
        "A textual label that uniquely identifies the part's semantic type.",
        "A textual label, within a namespace, that identifies a specific attribute, characteristic, or quality of the property's containing object.",
        "The capability's human-readable name.",
        "The common name of the protocol, which should be the appropriate \"service name\" from the IANA Service Name and Transport Protocol Port Number Registry." ;
    rdfs:domain oscal:AssessmentPart,
        oscal:Capability,
        oscal:Part,
        oscal:Property,
        oscal:Protocol ;
    rdfs:range xsd:string,
        xsd:token .

oscal:network-architecture a owl:ObjectProperty ;
    rdfs:label "network-architecture" ;
    rdfs:domain oscal:SystemCharacteristics ;
    rdfs:range oscal:NetworkArchitecture .

oscal:ns a owl:DatatypeProperty ;
    rdfs:label "Part Namespace",
        "Property Namespace",
        "Relationship Value Namespace",
        "Resource Type Namespace" ;
    rdfs:comment "A namespace qualifying the part's name. This allows different organizations to associate distinct semantics with the same name.",
        "A namespace qualifying the property's name. This allows different organizations to associate distinct semantics with the same name.",
        "A namespace qualifying the relationship's value. This allows different organizations to associate distinct semantics for relationships with the same name.",
        "An optional namespace qualifying the part's name. This allows different organizations to associate distinct semantics with the same name.",
        "An optional namespace qualifying the resource's type." ;
    rdfs:domain oscal:AssessmentPart,
        oscal:Map,
        oscal:MappingResourceReference,
        oscal:Part,
        oscal:Property ;
    rdfs:range xsd:anyURI .

oscal:objective-id a owl:DatatypeProperty ;
    rdfs:label "objective-id" ;
    rdfs:domain oscal:SelectObjectiveById ;
    rdfs:range xsd:string .

oscal:observation a owl:ObjectProperty ;
    rdfs:label "observation" ;
    rdfs:domain oscal:PlanOfActionAndMilestones,
        oscal:Result ;
    rdfs:range oscal:Observation .

oscal:observation-uuid a owl:DatatypeProperty ;
    rdfs:label "Observation Universally Unique Identifier Reference" ;
    rdfs:comment "A machine-oriented identifier reference to an observation defined in the list of observations." ;
    rdfs:domain oscal:RelatedObservation ;
    rdfs:range xsd:string .

oscal:order a owl:DatatypeProperty ;
    rdfs:label "Order" ;
    rdfs:comment "A designation of how a selection of controls in a profile is to be ordered." ;
    rdfs:domain oscal:InsertControls ;
    rdfs:range xsd:token .

oscal:origin a owl:ObjectProperty ;
    rdfs:label "origin" ;
    rdfs:domain oscal:Characterization,
        oscal:Finding,
        oscal:Observation,
        oscal:Response,
        oscal:Risk ;
    rdfs:range oscal:Origin .

oscal:origin-actor a owl:ObjectProperty ;
    rdfs:label "origin-actor" ;
    rdfs:domain oscal:Origin,
        oscal:PoamItem ;
    rdfs:range oscal:OriginActor .

oscal:oscal-version a owl:DatatypeProperty ;
    rdfs:label "OSCAL Version",
        "oscal-version" ;
    rdfs:comment "The OSCAL model version the document was authored against and will conform to as valid." ;
    rdfs:domain oscal:Metadata ;
    rdfs:range xsd:string .

oscal:param-id a owl:DatatypeProperty ;
    rdfs:label "param-id" ;
    rdfs:domain oscal:SetParameter ;
    rdfs:range xsd:string .

oscal:parameter a owl:ObjectProperty ;
    rdfs:label "parameter" ;
    rdfs:domain oscal:Catalog,
        oscal:Control,
        oscal:Group,
        oscal:Modify ;
    rdfs:range oscal:Parameter .

oscal:parameter-constraint a owl:ObjectProperty ;
    rdfs:label "parameter-constraint" ;
    rdfs:domain oscal:Modify,
        oscal:Parameter ;
    rdfs:range oscal:ParameterConstraint .

oscal:parameter-guideline a owl:ObjectProperty ;
    rdfs:label "parameter-guideline" ;
    rdfs:domain oscal:Modify,
        oscal:Parameter ;
    rdfs:range oscal:ParameterGuideline .

oscal:parameter-selection a owl:ObjectProperty ;
    rdfs:label "parameter-selection" ;
    rdfs:domain oscal:Modify,
        oscal:Parameter ;
    rdfs:range oscal:ParameterSelection .

oscal:parameter-value a owl:DatatypeProperty ;
    rdfs:label "parameter-value" ;
    rdfs:domain oscal:Modify,
        oscal:Parameter ;
    rdfs:range xsd:string .

oscal:part a owl:ObjectProperty ;
    rdfs:label "part" ;
    rdfs:domain oscal:Control,
        oscal:Group,
        oscal:LocalObjective,
        oscal:Modify,
        oscal:Part ;
    rdfs:range oscal:Part .

oscal:party-uuid a owl:DatatypeProperty ;
    rdfs:label "Party UUID Reference",
        "Party Universally Unique Identifier Reference" ;
    rdfs:comment "A machine-oriented identifier reference to the party who is making the log entry.",
        "Reference to a party by UUID." ;
    rdfs:domain oscal:LoggedBy,
        oscal:ResponsibleParty,
        oscal:ResponsibleRole ;
    rdfs:range xsd:string .

oscal:pattern a owl:DatatypeProperty ;
    rdfs:label "pattern" ;
    rdfs:domain oscal:Matching ;
    rdfs:range xsd:string .

oscal:percentage a owl:DatatypeProperty ;
    rdfs:label "percentage" ;
    rdfs:domain oscal:ConfidenceScore ;
    rdfs:range xsd:decimal .

oscal:poam-item a owl:ObjectProperty ;
    rdfs:label "poam-item" ;
    rdfs:domain oscal:PlanOfActionAndMilestones ;
    rdfs:range oscal:PoamItem .

oscal:port-range a owl:ObjectProperty ;
    rdfs:label "port-range" ;
    rdfs:domain oscal:Protocol ;
    rdfs:range oscal:PortRange .

oscal:predicate a owl:DatatypeProperty ;
    rdfs:label "Predicate" ;
    rdfs:comment "The predicate describes how the qualifer applies to the subject." ;
    rdfs:domain oscal:QualifierItem ;
    rdfs:range xsd:string .

oscal:property a owl:ObjectProperty ;
    rdfs:label "property" ;
    rdfs:domain oscal:Action,
        oscal:Activity,
        oscal:AssessmentAssets,
