@prefix oscal: <https://csrc.nist.gov/ns/oscal/semantic/1.0#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oscal:ActionShape a sh:NodeShape ;
    rdfs:label "Action shape" ;
    sh:property [ sh:class oscal:ResponsibleParty ;
            sh:path oscal:responsible-party ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path oscal:date ],
        [ sh:datatype rdf:HTML ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:system ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:uuid ],
        [ sh:datatype xsd:token ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:type ] ;
    sh:targetClass oscal:Action .

oscal:ActivityShape a sh:NodeShape ;
    rdfs:label "Activity shape" ;
    sh:property [ sh:class oscal:ResponsibleRole ;
            sh:path oscal:responsible-role ],
        [ sh:class oscal:ResponsibleRole ;
            sh:path oscal:responsible-role ],
        [ sh:class oscal:ReviewedControls ;
            sh:path oscal:reviewed-controls ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:uuid ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:datatype rdf:HTML ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:ReviewedControls ;
            sh:path oscal:reviewed-controls ],
        [ sh:datatype rdf:HTML ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ] ;
    sh:targetClass oscal:Activity .

oscal:AddressShape a sh:NodeShape ;
    rdfs:label "Address shape" ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path oscal:location-type ],
        [ sh:datatype xsd:string ;
            sh:path oscal:addr-line ] ;
    sh:targetClass oscal:Address .

oscal:AssessmentAssetsShape a sh:NodeShape ;
    rdfs:label "Assessment Assets shape" ;
    sh:property [ sh:class oscal:SystemComponent ;
            sh:minCount 0 ;
            sh:path oscal:system-component ],
        [ sh:datatype rdf:HTML ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:datatype rdf:HTML ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:class oscal:ResponsibleParty ;
            sh:path oscal:responsible-party ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ] ;
    sh:targetClass oscal:AssessmentAssets .

oscal:AssessmentMethodShape a sh:NodeShape ;
    rdfs:label "Assessment Method shape" ;
    sh:property [ sh:class oscal:AssessmentPart ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:assessment-part ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:uuid ],
        [ sh:datatype rdf:HTML ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ] ;
    sh:targetClass oscal:AssessmentMethod .

oscal:AssessmentPartShape a sh:NodeShape ;
    rdfs:label "Assessment Part shape" ;
    sh:property [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:datatype xsd:token ;
            sh:maxCount 1 ;
            sh:path oscal:class ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path oscal:uuid ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:path oscal:ns ],
        [ sh:class oscal:AssessmentPart ;
            sh:path oscal:assessment-part ],
        [ sh:datatype xsd:token ;
            sh:in ( "asset" "method" "objective" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:name ] ;
    sh:targetClass oscal:AssessmentPart .

oscal:AssessmentPlanShape a sh:NodeShape ;
    rdfs:label "Security Assessment Plan (SAP) shape" ;
    sh:property [ sh:class oscal:AssessmentPart ;
            sh:path oscal:assessment-part ],
        [ sh:class oscal:AssessmentSubject ;
            sh:minCount 0 ;
            sh:path oscal:assessment-subject ],
        [ sh:class oscal:AssessmentAssets ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path oscal:assessment-assets ],
        [ sh:class oscal:ImportSsp ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:import-ssp ],
        [ sh:class oscal:Metadata ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:metadata ],
        [ sh:class oscal:ReviewedControls ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:reviewed-controls ],
        [ sh:class oscal:BackMatter ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path oscal:back-matter ],
        [ sh:class oscal:InventoryItem ;
            sh:minCount 0 ;
            sh:path oscal:inventory-item ],
        [ sh:class oscal:SystemComponent ;
            sh:minCount 0 ;
            sh:path oscal:system-component ],
        [ sh:class oscal:SystemUser ;
            sh:minCount 0 ;
            sh:path oscal:system-user ],
        [ sh:datatype rdf:HTML ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Task ;
            sh:minCount 0 ;
            sh:path oscal:task ],
        [ sh:class oscal:LocalObjective ;
            sh:minCount 0 ;
            sh:path oscal:local-objective ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:uuid ],
        [ sh:class oscal:Activity ;
            sh:minCount 0 ;
            sh:path oscal:activity ] ;
    sh:targetClass oscal:AssessmentPlan .

oscal:AssessmentResultsShape a sh:NodeShape ;
    rdfs:label "Security Assessment Results (SAR) shape" ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:uuid ],
        [ sh:class oscal:LocalObjective ;
            sh:minCount 0 ;
            sh:path oscal:local-objective ],
        [ sh:class oscal:ImportAp ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:import-ap ],
        [ sh:class oscal:Metadata ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:metadata ],
        [ sh:class oscal:Activity ;
            sh:minCount 0 ;
            sh:path oscal:activity ],
        [ sh:class oscal:BackMatter ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path oscal:back-matter ],
        [ sh:datatype rdf:HTML ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Result ;
            sh:minCount 1 ;
            sh:path oscal:result ] ;
    sh:targetClass oscal:AssessmentResults .

oscal:AssessmentSubjectPlaceholderShape a sh:NodeShape ;
    rdfs:label "Assessment Subject Placeholder shape" ;
    sh:property [ sh:datatype rdf:HTML ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:datatype rdf:HTML ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:uuid ] ;
    sh:targetClass oscal:AssessmentSubjectPlaceholder .

oscal:AssessmentSubjectShape a sh:NodeShape ;
    rdfs:label "Subject of Assessment shape" ;
    sh:property [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:class oscal:IncludeAll ;
            sh:minCount 1 ;
            sh:path oscal:include-all ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:datatype xsd:token ;
            sh:in ( "component" "inventory-item" "location" "party" "user" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:type ],
        [ sh:class oscal:SelectSubjectById ;
            sh:minCount 1 ;
            sh:path oscal:select-subject-by-id ],
        [ sh:class oscal:SelectSubjectById ;
            sh:minCount 0 ;
            sh:path oscal:select-subject-by-id ],
        [ sh:datatype rdf:HTML ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:AssessmentSubject .

oscal:AssociatedRiskShape a sh:NodeShape ;
    rdfs:label "Associated Risk shape" ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:risk-uuid ],
        [ sh:datatype rdf:HTML ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:AssociatedRisk .

oscal:AuthorizationBoundaryShape a sh:NodeShape ;
    rdfs:label "Authorization Boundary shape" ;
    sh:property [ sh:class oscal:Diagram ;
            sh:path oscal:diagram ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:datatype rdf:HTML ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ] ;
    sh:targetClass oscal:AuthorizationBoundary .

oscal:AuthorizedPrivilegeShape a sh:NodeShape ;
    rdfs:label "Privilege shape" ;
    sh:property [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path oscal:function-performed ] ;
    sh:targetClass oscal:AuthorizedPrivilege .

oscal:BackMatterShape a sh:NodeShape ;
    rdfs:label "Back matter shape" ;
    sh:property [ sh:datatype rdf:HTML ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:datatype xsd:string ;
            sh:in ( "SHA-224" "SHA-256" "SHA-384" "SHA-512" "SHA3-224" "SHA3-256" "SHA3-384" "SHA3-512" ) ;
            sh:path oscal:hash ],
        [ sh:datatype xsd:string ;
            sh:in ( "http://www.doi.org/" ) ;
            sh:path oscal:document-id ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ] ;
    sh:targetClass oscal:BackMatter .

oscal:ByComponentShape a sh:NodeShape ;
    rdfs:label "Component Control Implementation shape" ;
    sh:property [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:class oscal:ResponsibleRole ;
            sh:minCount 0 ;
            sh:path oscal:responsible-role ],
        [ sh:class oscal:ResponsibleRole ;
            sh:minCount 0 ;
            sh:path oscal:responsible-role ],
        [ sh:class oscal:ResponsibleRole ;
            sh:minCount 0 ;
            sh:path oscal:responsible-role ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:uuid ],
        [ sh:datatype rdf:HTML ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:class oscal:ImplementationStatus ;
            sh:path oscal:implementation-status ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:class oscal:ResponsibleRole ;
            sh:minCount 0 ;
            sh:path oscal:responsible-role ],
        [ sh:class oscal:ResponsibleRole ;
            sh:path oscal:responsible-role ],
        [ sh:datatype rdf:HTML ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:class oscal:SetParameter ;
            sh:path oscal:set-parameter ],
        [ sh:datatype rdf:HTML ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:component-uuid ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:datatype rdf:HTML ;
            sh:path oscal:remarks ],
        [ sh:datatype rdf:HTML ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:ByComponent .

oscal:CapabilityShape a sh:NodeShape ;
    rdfs:label "Capability shape" ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:uuid ],
        [ sh:class oscal:IncorporatesComponent ;
            sh:path oscal:incorporates-component ],
        [ sh:class oscal:ControlImplementation ;
            sh:path oscal:control-implementation ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:datatype rdf:HTML ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:name ] ;
    sh:targetClass oscal:Capability .

oscal:CatalogShape a sh:NodeShape ;
    rdfs:label "Catalog shape" ;
    sh:property [ sh:class oscal:Group ;
            sh:path oscal:group ],
        [ sh:class oscal:Parameter ;
            sh:path oscal:parameter ],
        [ sh:class oscal:BackMatter ;
            sh:path oscal:back-matter ],
        [ sh:class oscal:Control ;
            sh:path oscal:control ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:uuid ],
        [ sh:class oscal:Metadata ;
            sh:minCount 1 ;
            sh:path oscal:metadata ] ;
    sh:targetClass oscal:Catalog .

oscal:CharacterizationShape a sh:NodeShape ;
    rdfs:label "Characterization shape" ;
    sh:property [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:class oscal:Origin ;
            sh:minCount 1 ;
            sh:path oscal:origin ],
        [ sh:datatype rdf:HTML ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:Characterization .

oscal:ComponentDefinitionShape a sh:NodeShape ;
    rdfs:label "Component Definition shape" ;
    sh:property [ sh:class oscal:ImportComponentDefinition ;
            sh:path oscal:import-component-definition ],
        [ sh:class oscal:Metadata ;
            sh:minCount 1 ;
            sh:path oscal:metadata ],
        [ sh:class oscal:DefinedComponent ;
            sh:path oscal:defined-component ],
        [ sh:class oscal:BackMatter ;
            sh:path oscal:back-matter ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:uuid ],
        [ sh:class oscal:Capability ;
            sh:path oscal:capability ] ;
    sh:targetClass oscal:ComponentDefinition .

oscal:ConfidenceScoreShape a sh:NodeShape ;
    rdfs:label "Confidence Score shape" ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:path oscal:percentage ] ;
    sh:targetClass oscal:ConfidenceScore .

oscal:ControlImplementationShape a sh:NodeShape ;
    rdfs:label "Control Implementation Set shape" ;
    sh:property [ sh:class oscal:SetParameter ;
            sh:path oscal:set-parameter ],
        [ sh:class oscal:ImplementedRequirement ;
            sh:minCount 1 ;
            sh:path oscal:implemented-requirement ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:uuid ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:source ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ] ;
    sh:targetClass oscal:ControlImplementation .

oscal:ControlShape a sh:NodeShape ;
    rdfs:label "Control shape" ;
    sh:property [ sh:datatype xsd:token ;
            sh:maxCount 1 ;
            sh:path oscal:class ],
        [ sh:class oscal:Part ;
            sh:path oscal:part ],
        [ sh:class oscal:Parameter ;
            sh:path oscal:parameter ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:class oscal:Control ;
            sh:path oscal:control ],
        [ sh:datatype xsd:token ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:id ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ] ;
    sh:targetClass oscal:Control .

oscal:DataFlowShape a sh:NodeShape ;
    rdfs:label "Data Flow shape" ;
    sh:property [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:datatype rdf:HTML ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Diagram ;
            sh:path oscal:diagram ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ] ;
    sh:targetClass oscal:DataFlow .

oscal:DefinedComponentShape a sh:NodeShape ;
    rdfs:label "Component shape" ;
    sh:property [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:class oscal:ControlImplementation ;
            sh:path oscal:control-implementation ],
        [ sh:class oscal:Protocol ;
            sh:path oscal:protocol ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:uuid ],
        [ sh:class oscal:ResponsibleRole ;
            sh:path oscal:responsible-role ],
        [ sh:datatype rdf:HTML ;
            sh:path oscal:remarks ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:defined-component-type ] ;
    sh:targetClass oscal:DefinedComponent .

oscal:DiagramShape a sh:NodeShape ;
    rdfs:label "Diagram shape" ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:uuid ],
        [ sh:datatype rdf:HTML ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ] ;
    sh:targetClass oscal:Diagram .

oscal:FindingShape a sh:NodeShape ;
    rdfs:label "Finding shape" ;
    sh:property [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:datatype rdf:HTML ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:AssociatedRisk ;
            sh:path oscal:associated-risk ],
        [ sh:class oscal:RelatedObservation ;
            sh:path oscal:related-observation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:uuid ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:class oscal:FindingTarget ;
            sh:minCount 1 ;
            sh:path oscal:finding-target ],
        [ sh:class oscal:Origin ;
            sh:path oscal:origin ] ;
    sh:targetClass oscal:Finding .

oscal:FindingTargetShape a sh:NodeShape ;
    rdfs:label "Objective Status shape" ;
    sh:property [ sh:class oscal:ImplementationStatus ;
            sh:path oscal:implementation-status ],
        [ sh:datatype xsd:token ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:target-id ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:datatype xsd:string ;
            sh:in ( "statement-id" "objective-id" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:type ],
        [ sh:datatype rdf:HTML ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path oscal:remarks ],
        [ sh:datatype rdf:HTML ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path oscal:remarks ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ] ;
    sh:targetClass oscal:FindingTarget .

oscal:GapSummaryShape a sh:NodeShape ;
    rdfs:label "Gap Summary shape" ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:uuid ],
        [ sh:class oscal:SelectControlById ;
            sh:minCount 1 ;
            sh:path oscal:select-control-by-id ] ;
    sh:targetClass oscal:GapSummary .

oscal:GroupShape a sh:NodeShape ;
    rdfs:label "Control Group shape" ;
    sh:property [ sh:class oscal:Group ;
            sh:path oscal:group ],
        [ sh:datatype xsd:token ;
            sh:maxCount 1 ;
            sh:path oscal:id ],
        [ sh:class oscal:Parameter ;
            sh:path oscal:parameter ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:datatype xsd:token ;
            sh:maxCount 1 ;
            sh:path oscal:class ],
        [ sh:class oscal:Part ;
            sh:path oscal:part ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:class oscal:Control ;
            sh:path oscal:control ] ;
    sh:targetClass oscal:Group .

oscal:ImpactShape a sh:NodeShape ;
    rdfs:label "Impact Level shape" ;
    sh:property [ sh:datatype rdf:HTML ;
            sh:path oscal:adjustment-justification ],
        [ sh:datatype xsd:string ;
            sh:path oscal:selected ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:datatype xsd:string ;
            sh:minCount 1 ;
            sh:path oscal:base ] ;
    sh:targetClass oscal:Impact .

oscal:ImplementationStatusShape a sh:NodeShape ;
    rdfs:label "Implementation Status shape" ;
    sh:property [ sh:datatype xsd:token ;
            sh:in ( "implemented" "partial" "planned" "alternative" "not-applicable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:state ],
        [ sh:datatype rdf:HTML ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path oscal:remarks ] ;
    sh:targetClass oscal:ImplementationStatus .

oscal:ImplementedRequirementShape a sh:NodeShape ;
    rdfs:label "Control Implementation shape" ;
    sh:property [ sh:class oscal:ResponsibleRole ;
            sh:path oscal:responsible-role ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:control-id ],
        [ sh:class oscal:Link ;
            sh:path oscal:link ],
        [ sh:class oscal:SetParameter ;
            sh:path oscal:set-parameter ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path oscal:uuid ],
        [ sh:class oscal:Property ;
            sh:path oscal:property ],
        [ sh:class oscal:Statement ;
            sh:path oscal:statement ],
        [ sh:datatype rdf:HTML ;
