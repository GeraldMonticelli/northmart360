@prefix cyfun: <https://cyfun.eu/control/> .
@prefix poc:   <https://example.org/cyfun-poc#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# ---------------------------------------------------------------------------
# CyFun ESSENTIAL semantic retrieval layer — PoC, NON-NORMATIVE.
# Generated from the CyFun OSCAL catalog + ESSENTIAL profile.
# poc:concerns / poc:hasAction are heuristic retrieval annotations derived
# from CyFun IDs, hierarchy titles and control statements. They are NOT
# official CyFun mappings or implementation requirements.
# ---------------------------------------------------------------------------

poc:SemanticConcept a owl:Class .
poc:Action a owl:Class .
poc:Domain a owl:Class .
poc:concerns a owl:ObjectProperty ; rdfs:range poc:SemanticConcept .
poc:hasAction a owl:ObjectProperty ; rdfs:range poc:Action .
poc:inDomain a owl:ObjectProperty ; rdfs:range poc:Domain .
poc:mappingMethod a owl:DatatypeProperty .

poc:Governance a poc:Domain ; rdfs:label "Governance" .
poc:Identify a poc:Domain ; rdfs:label "Identify" .
poc:Protect a poc:Domain ; rdfs:label "Protect" .
poc:Detect a poc:Domain ; rdfs:label "Detect" .
poc:Respond a poc:Domain ; rdfs:label "Respond" .
poc:Recover a poc:Domain ; rdfs:label "Recover" .

poc:AnomalyDetection a owl:Class, poc:SemanticConcept ; rdfs:subClassOf poc:Detection ; rdfs:label "Anomaly Detection" .
