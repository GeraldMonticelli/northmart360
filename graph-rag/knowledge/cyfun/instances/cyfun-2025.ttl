<https://cyfun.eu/resource/document-id/e8a3b87c-45e2-4cab-989b-abebf90bbbeb-1> a oscal:DocumentId ;
    oscal:identifier "99e0dac7-7686-48ac-ab20-20dce265edd6" ;
    oscal:index 1 ;
    oscal:scheme <http://oscal.io/oscal/identifier/contentuuid> .

<https://cyfun.eu/resource/document-id/e8a3b87c-45e2-4cab-989b-abebf90bbbeb-2> a oscal:DocumentId ;
    oscal:identifier "6bd89eb7-27eb-47fb-aeac-758c85d4e2a0" ;
    oscal:index 2 ;
    oscal:scheme <http://oscal.io/oscal/identifier/content-uuid> .

<https://cyfun.eu/resource/metadata/e8a3b87c-45e2-4cab-989b-abebf90bbbeb> a oscal:Metadata ;
    oscal:documentId <https://cyfun.eu/resource/document-id/e8a3b87c-45e2-4cab-989b-abebf90bbbeb-1>,
        <https://cyfun.eu/resource/document-id/e8a3b87c-45e2-4cab-989b-abebf90bbbeb-2> ;
    oscal:lastModified "2025-12-16T22:09:59.499Z" ;
    oscal:oscalVersion "1.1.3" ;
    oscal:published "2024-01-08T00:00:00.000Z" ;
    oscal:title "CyFun 2025 Framework" ;
    oscal:version "2025-10-01" .

<https://cyfun.eu/resource/part/DE.AE-02.1_smt> a oscal:Part ;
    oscal:id "DE.AE-02.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Cybersecurity and information security events must be reviewed and analysed to identify potential attack targets and methods, in accordance with applicable laws, regulations, standards, and policies." .

<https://cyfun.eu/resource/part/DE.AE-02.2_smt> a oscal:Part ;
    oscal:id "DE.AE-02.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall implement automated mechanisms where feasible to review and analyse detected events." .

<https://cyfun.eu/resource/part/DE.AE-03.1_smt> a oscal:Part ;
    oscal:id "DE.AE-03.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The logging functionality of protection and detection tools shall be enabled. Logs shall be backed up and retained for a predefined period, and regularly reviewed to identify unusual or potentially harmful activity." .

<https://cyfun.eu/resource/part/DE.AE-03.2_smt> a oscal:Part ;
    oscal:id "DE.AE-03.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall ensure that event data from critical systems is collected and correlated using information from multiple relevant sources." .

<https://cyfun.eu/resource/part/DE.AE-03.3_smt> a oscal:Part ;
    oscal:id "DE.AE-03.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall combine event analysis with information from vulnerability scans, system performance data, monitoring of critical systems, and facility monitoring, where feasible." .

<https://cyfun.eu/resource/part/DE.AE-04.1_smt> a oscal:Part ;
    oscal:id "DE.AE-04.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall assess the negative impacts of detected events on its operations, assets, and individuals, and shall link these impacts to the results of its risk assessments." .

<https://cyfun.eu/resource/part/DE.AE-06.1_smt> a oscal:Part ;
    oscal:id "DE.AE-06.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Information about adverse events must be promptly delivered to authorised personnel and systems to enable timely detection, investigation, and response." .

<https://cyfun.eu/resource/part/DE.AE-08.1_smt> a oscal:Part ;
    oscal:id "DE.AE-08.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Incidents shall be reported when adverse events meet defined and documented incident criteria." .

<https://cyfun.eu/resource/part/DE.AE-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "Anomalies, indicators of compromise, and other potentially adverse events are analysed to characterise the events and detect cybersecurity incidents." .

<https://cyfun.eu/resource/part/DE.CM-01.1_smt> a oscal:Part ;
    oscal:id "DE.CM-01.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Firewalls shall be installed and operated at the network boundaries, including endpoint firewalls." .

<https://cyfun.eu/resource/part/DE.CM-01.2_smt> a oscal:Part ;
    oscal:id "DE.CM-01.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Anti-virus, -spyware, and other -malware programs shall be installed and updated." .

<https://cyfun.eu/resource/part/DE.CM-01.3_smt> a oscal:Part ;
    oscal:id "DE.CM-01.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall monitor and identify unauthorised use of its business-critical systems through the detection of unauthorised local connections, network connections and remote connections." .

<https://cyfun.eu/resource/part/DE.CM-01.4_smt> a oscal:Part ;
    oscal:id "DE.CM-01.4_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall continuously monitor its network to spot signs of cyber threats or unusual activity, using clearly defined rules for what counts as a potential security incident." .

<https://cyfun.eu/resource/part/DE.CM-02.1_smt> a oscal:Part ;
    oscal:id "DE.CM-02.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The physical environment shall be monitored to find potentially adverse events." .

<https://cyfun.eu/resource/part/DE.CM-02.2_smt> a oscal:Part ;
    oscal:id "DE.CM-02.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Physical access to the organisation's critical systems and devices, in addition to physical access monitoring to the facility, shall be supplemented by physical intrusion alarms, surveillance equipment, and independent monitoring teams." .

<https://cyfun.eu/resource/part/DE.CM-03-1_smt> a oscal:Part ;
    oscal:id "DE.CM-03-1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "End point and network protection tools to monitor end-user behaviour for dangerous activity shall be implemented." .

<https://cyfun.eu/resource/part/DE.CM-03.2_smt> a oscal:Part ;
    oscal:id "DE.CM-03.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "End point and network protection tools that monitor end-user behaviour for dangerous activity shall be managed." .

<https://cyfun.eu/resource/part/DE.CM-06.1_smt> a oscal:Part ;
    oscal:id "DE.CM-06.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "External service provider activities and services shall be secured and monitored to find potentially adverse events." .

<https://cyfun.eu/resource/part/DE.CM-06.2_smt> a oscal:Part ;
    oscal:id "DE.CM-06.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "External service providers' conformance with personnel security policies and procedures and contract security requirements shall be monitored relative to their cybersecurity risks." .

<https://cyfun.eu/resource/part/DE.CM-09.1_smt> a oscal:Part ;
    oscal:id "DE.CM-09.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall monitor computing hardware, software, runtime environments, and their data to detect potentially adverse events." .

<https://cyfun.eu/resource/part/DE.CM-09.2_smt> a oscal:Part ;
    oscal:id "DE.CM-09.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall implement hardware integrity checks to detect unauthorised tampering of critical system hardware. Controls shall be proportionate to the organisation’s risk profile and operational capacity." .

<https://cyfun.eu/resource/part/DE.CM-09.3_smt> a oscal:Part ;
    oscal:id "DE.CM-09.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation's incident response plan shall include measures to detect unauthorised tampering with the hardware of critical systems." .

<https://cyfun.eu/resource/part/DE.CM-09.4_smt> a oscal:Part ;
    oscal:id "DE.CM-09.4_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall establish a system to accurately distinguish between legitimate alerts and false positives, ensuring effective detection and removal of malicious code." .

<https://cyfun.eu/resource/part/DE.CM-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "Assets are monitored to find anomalies, indicators of compromise, and other potentially adverse events." .

<https://cyfun.eu/resource/part/GV.OC-01.1_smt> a oscal:Part ;
    oscal:id "GV.OC-01.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation's mission shall be established, communicated and shall form the basis for information and cybersecurity risk management." .

<https://cyfun.eu/resource/part/GV.OC-02.1_smt> a oscal:Part ;
    oscal:id "GV.OC-02.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall demonstrate it understands and considers the needs and expectations of both internal and external stakeholders regarding information and cybersecurity risk management." .

<https://cyfun.eu/resource/part/GV.OC-03.1_smt> a oscal:Part ;
    oscal:id "GV.OC-03.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Legal and regulatory requirements regarding information and cybersecurity shall be identified and implemented." .

<https://cyfun.eu/resource/part/GV.OC-03.2_smt> a oscal:Part ;
    oscal:id "GV.OC-03.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Legal, regulatory, and contractual obligations related to information and cybersecurity shall be continuously managed to ensure they remain accurate, up-to-date, and effectively applied." .

<https://cyfun.eu/resource/part/GV.OC-04.1_smt> a oscal:Part ;
    oscal:id "GV.OC-04.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall identify, document, and communicate the critical objectives, capabilities, and services relied upon by external stakeholders, prioritise them based on criticality, and integrate this prioritisation into the risk assessment process." .

<https://cyfun.eu/resource/part/GV.OC-04.2_smt> a oscal:Part ;
    oscal:id "GV.OC-04.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall define and document cybersecurity requirements for essential operations, validate them through testing and audits, keep records of results and corrective actions, and regularly update requirements based on evolving risks." .

<https://cyfun.eu/resource/part/GV.OC-04.3_smt> a oscal:Part ;
    oscal:id "GV.OC-04.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Redundancy shall be implemented to meet availability requirements as defined by the organisation, legislation and/or regulations." .

<https://cyfun.eu/resource/part/GV.OC-04.4_smt> a oscal:Part ;
    oscal:id "GV.OC-04.4_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Recovery time and recovery point objectives for the resumption of essential ICT/OT system processes shall be defined and monitored." .

<https://cyfun.eu/resource/part/GV.OC-05.1_smt> a oscal:Part ;
    oscal:id "GV.OC-05.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organization shall identify, document, and communicate its role in the supply chain, including the external capabilities, services, and dependencies it relies on (upstream), as well as its interactions with downstream stakeholders." .

<https://cyfun.eu/resource/part/GV.OC-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "The circumstances - mission, stakeholder expectations, dependencies, and legal, regulatory, and contractual requirements - surrounding the organisation's cybersecurity risk management decisions are understood." .

<https://cyfun.eu/resource/part/GV.OV-02.1_smt> a oscal:Part ;
    oscal:id "GV.OV-02.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The information and cybersecurity risk management strategy shall be reviewed and adjusted to ensure coverage of organisational requirements and risks." .

<https://cyfun.eu/resource/part/GV.OV-03.1_smt> a oscal:Part ;
    oscal:id "GV.OV-03.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation's cybersecurity risk management performance shall be evaluated, reviewed and adapted when necessary." .

<https://cyfun.eu/resource/part/GV.OV-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "Results of organisation-wide cybersecurity risk management activities and performance are used to inform, improve, and adjust the risk management strategy." .

<https://cyfun.eu/resource/part/GV.PO-01.1_smt> a oscal:Part ;
    oscal:id "GV.PO-01.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Policies and procedures for managing information and cybersecurity shall be established, documented, reviewed, approved, updated when changes occur, communicated and enforced." .

<https://cyfun.eu/resource/part/GV.PO-01.2_smt> a oscal:Part ;
    oscal:id "GV.PO-01.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Organisational-wide information and cyber security policies and procedures shall include the use of cryptography and, where appropriate, encryption, reflect changes in requirements, threats, technology and organisational roles, and be approved by senior management, who oversee implementation." .

<https://cyfun.eu/resource/part/GV.PO-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "Organisational cybersecurity policy is established, communicated, and enforced." .

<https://cyfun.eu/resource/part/GV.RM-01.1_smt> a oscal:Part ;
    oscal:id "GV.RM-01.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Information/cybersecurity objectives shall be identified, agreed to by organisational stakeholders and approved by senior management" .

<https://cyfun.eu/resource/part/GV.RM-02.1_smt> a oscal:Part ;
    oscal:id "GV.RM-02.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Risk appetite and risk tolerance statements shall be defined, documented, approved by senior management, communicated, and maintained." .

<https://cyfun.eu/resource/part/GV.RM-03.1_smt> a oscal:Part ;
    oscal:id "GV.RM-03.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "As part of the organisation-wide risk management strategy, a comprehensive strategy to manage information and cybersecurity risks shall be developed and updated when changes occur." .

<https://cyfun.eu/resource/part/GV.RM-03.2_smt> a oscal:Part ;
    oscal:id "GV.RM-03.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Information and cybersecurity risks shall be documented, as part of the enterprise risk management processes, formally approved by senior management, and updated when changes occur." .

<https://cyfun.eu/resource/part/GV.RM-04.1_smt> a oscal:Part ;
    oscal:id "GV.RM-04.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "A high-level plan or vision shall be formally established and clearly communicated to everyone involved on how to manage risks, including the different strategies the organisation can employ to deal with identified risks based on risk appetite or risk tolerance level." .

<https://cyfun.eu/resource/part/GV.RM-05.1_smt> a oscal:Part ;
    oscal:id "GV.RM-05.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "To support the high-level risk management vision, the organisation shall establish clear lines of communication for cybersecurity risks, including those arising from suppliers and third parties." .

<https://cyfun.eu/resource/part/GV.RM-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "The organisation's priorities, constraints, risk tolerance and appetite statements, and assumptions, are established, communicated, and used to support operational risk decisions." .

<https://cyfun.eu/resource/part/GV.RR-01.1_smt> a oscal:Part ;
    oscal:id "GV.RR-01.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation's top management shall be responsible and accountable for cybersecurity risk and shall foster a culture that is risk-aware, ethical, and continually improving." .

<https://cyfun.eu/resource/part/GV.RR-02.1_smt> a oscal:Part ;
    oscal:id "GV.RR-02.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Information security and Cyber security roles, responsibilities and authorities for employees, suppliers, customers, and partners shall be documented, reviewed, authorised, kept up-to-date, communicated, and coordinated internally and externally.." .

<https://cyfun.eu/resource/part/GV.RR-02.2_smt> a oscal:Part ;
    oscal:id "GV.RR-02.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall appoint a senior-level executive information security officer." .

<https://cyfun.eu/resource/part/GV.RR-03-1_smt> a oscal:Part ;
    oscal:id "GV.RR-03-1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Sufficient resources shall be allocated in line with the cybersecurity risk strategy, roles, responsibilities and policies." .

<https://cyfun.eu/resource/part/GV.RR-03-2_smt> a oscal:Part ;
    oscal:id "GV.RR-03-2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall assign roles and responsibilities for reviewing and updating response and recovery plans, ensuring they reflect changes in the risk environment and remain effective." .

<https://cyfun.eu/resource/part/GV.RR-04.1_smt> a oscal:Part ;
    oscal:id "GV.RR-04.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Personnel with access to the organisation’s most critical information or technology shall be authenticated.." .

<https://cyfun.eu/resource/part/GV.RR-04.2_smt> a oscal:Part ;
    oscal:id "GV.RR-04.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "A cybersecurity process for human resources shall be developed and maintained applicable at recruitment, during employment and at termination of employment." .

<https://cyfun.eu/resource/part/GV.RR-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "Cybersecurity roles, responsibilities, and authorities to foster accountability, performance assessment, and continuous improvement are established and communicated." .

<https://cyfun.eu/resource/part/GV.SC-01.1_smt> a oscal:Part ;
    oscal:id "GV.SC-01.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "A cybersecurity supply chain risk management program, strategy, objectives, policies, and processes shall be documented, reviewed, updated when changes occur, and approved by organisational stakeholders." .

<https://cyfun.eu/resource/part/GV.SC-02.1_smt> a oscal:Part ;
    oscal:id "GV.SC-02.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Third-party providers shall notify any transfer, termination or transition of personnel with physical or logical access to business-critical system elements of the organisation." .

<https://cyfun.eu/resource/part/GV.SC-03.1_smt> a oscal:Part ;
    oscal:id "GV.SC-03.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Information- and Cybersecurity supply chain risk management shall be integrated into information/cybersecurity and enterprise risk management, risk assessment, and improvement processes." .

<https://cyfun.eu/resource/part/GV.SC-05.1_smt> a oscal:Part ;
    oscal:id "GV.SC-05.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Requirements for addressing cybersecurity risks and the sharing of sensitive information in supply chains shall be established, prioritised, integrated into contracts and other types of formal agreements, and enforced." .

<https://cyfun.eu/resource/part/GV.SC-05.2_smt> a oscal:Part ;
    oscal:id "GV.SC-05.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Contractual information/cybersecurity requirements for suppliers and external partners shall be implemented to ensure a verifiable flaw resolution process and to ensure that deficiencies identified during information/cybersecurity testing and evaluation are remedied." .

<https://cyfun.eu/resource/part/GV.SC-05.3_smt> a oscal:Part ;
    oscal:id "GV.SC-05.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall establish contractual requirements permitting the organisation to review the information/cybersecurity programmes implemented by suppliers and third-party partners." .

<https://cyfun.eu/resource/part/GV.SC-06.1_smt> a oscal:Part ;
    oscal:id "GV.SC-06.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Planning and due diligence shall be carried out to reduce risks before entering into formal relationships with suppliers or other third parties." .

<https://cyfun.eu/resource/part/GV.SC-07.1_smt> a oscal:Part ;
    oscal:id "GV.SC-07.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The risks posed by a supplier, its products and services and other third parties shall be identified, documented, prioritised, mitigated and assessed at least annually and when changes occur during the relationship." .

<https://cyfun.eu/resource/part/GV.SC-07.2_smt> a oscal:Part ;
    oscal:id "GV.SC-07.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "A documented list of all critical suppliers, vendors and partners of the organisation that may be involved in a major incident shall be established, kept up-to-date and made available online and off-line with due regard to confidentiality and security." .

<https://cyfun.eu/resource/part/GV.SC-07.3_smt> a oscal:Part ;
    oscal:id "GV.SC-07.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall audit business-critical third-party service providers for security compliance." .

<https://cyfun.eu/resource/part/GV.SC-07.4_smt> a oscal:Part ;
    oscal:id "GV.SC-07.4_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall ensure conformity with information/cybersecurity contractual obligations by suppliers and third-party partners through regular reviews of independent audits, assessments, and third party evaluations." .

<https://cyfun.eu/resource/part/GV.SC-08.1_smt> a oscal:Part ;
    oscal:id "GV.SC-08.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall identify and document key personnel from relevant suppliers and other third parties to include them in incident planning, response, and recovery activities." .

<https://cyfun.eu/resource/part/GV.SC-09.1_smt> a oscal:Part ;
    oscal:id "GV.SC-09.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Supply chain security practices shall be integrated into information/cybersecurity and enterprise risk management programs, and their performance shall be monitored throughout the product and service life cycle." .

<https://cyfun.eu/resource/part/GV.SC-10.1_smt> a oscal:Part ;
    oscal:id "GV.SC-10.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Cybersecurity supply chain risk management plans shall include actions and responsibilities for managing risks that may arise after a supplier relationship or service agreement has ended." .

<https://cyfun.eu/resource/part/GV.SC-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "Cyber supply chain risk management processes are identified, established, managed, monitored, and improved by organisational stakeholders." .

<https://cyfun.eu/resource/part/ID.AM-01.1_smt> a oscal:Part ;
    oscal:id "ID.AM-01.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "An inventory of physical and virtual infrastructure assets—such as hardware, network devices, and cloud-hosted environments—that support information processing shall be documented, reviewed, and updated as changes occur." .

<https://cyfun.eu/resource/part/ID.AM-01.2_smt> a oscal:Part ;
    oscal:id "ID.AM-01.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The inventory of enterprise assets associated with information and information processing facilities shall reflect changes in the organisation’s context and include all information necessary for effective accountability." .

<https://cyfun.eu/resource/part/ID.AM-01.3_smt> a oscal:Part ;
    oscal:id "ID.AM-01.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "When unauthorised hardware is detected, it shall be quarantined for possible exception handling, removed, or replaced, and the inventory shall be updated accordingly." .

<https://cyfun.eu/resource/part/ID.AM-01.4_smt> a oscal:Part ;
    oscal:id "ID.AM-01.4_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Mechanisms for detecting the presence of unauthorised hardware and firmware components within the organisation’s ICT/OT environment shall be identified." .

<https://cyfun.eu/resource/part/ID.AM-02.1_smt> a oscal:Part ;
    oscal:id "ID.AM-02.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "An inventory of software, digital services, and business systems used within the organisation shall be documented, reviewed, and updated as changes occur." .

<https://cyfun.eu/resource/part/ID.AM-02.2_smt> a oscal:Part ;
    oscal:id "ID.AM-02.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The inventory reflecting which software, services and systems are used in the organisation shall reflect changes in the organisation’s context and include all information necessary for effective accountability." .

<https://cyfun.eu/resource/part/ID.AM-02.3_smt> a oscal:Part ;
    oscal:id "ID.AM-02.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The people responsible and accountable for managing software platforms and applications within the organisation shall be formally identified." .

<https://cyfun.eu/resource/part/ID.AM-02.4_smt> a oscal:Part ;
    oscal:id "ID.AM-02.4_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "When unauthorised software is detected, it shall be quarantined for possible exception handling, removed, or replaced, and the inventory shall be updated accordingly." .

<https://cyfun.eu/resource/part/ID.AM-02.5_smt> a oscal:Part ;
    oscal:id "ID.AM-02.5_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Mechanisms for detecting the presence of unauthorised software within the organisation’s ICT/OT environment shall be identified." .

<https://cyfun.eu/resource/part/ID.AM-03-2_smt> a oscal:Part ;
    oscal:id "ID.AM-03-2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation's network communication and internal data flows shall be mapped, documented, authorised, and updated when changes occur." .

<https://cyfun.eu/resource/part/ID.AM-03-3_smt> a oscal:Part ;
    oscal:id "ID.AM-03-3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation's network communication and external data flows shall be mapped, documented , authorised, and updated when changes occur." .

<https://cyfun.eu/resource/part/ID.AM-04.1_smt> a oscal:Part ;
    oscal:id "ID.AM-04.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Organisations shall keep a clear and up-to-date list of all external services it uses, including how they connect to their systems. These services shall be reviewed and approved before use, and the list shall be updated whenever changes happen." .

<https://cyfun.eu/resource/part/ID.AM-04.2_smt> a oscal:Part ;
    oscal:id "ID.AM-04.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall map, document and authorise the flow of information to/from external systems and update the flow when changes occur." .

<https://cyfun.eu/resource/part/ID.AM-07.1_smt> a oscal:Part ;
    oscal:id "ID.AM-07.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Data that the organisation stores and uses shall be identified.." .

<https://cyfun.eu/resource/part/ID.AM-07.2_smt> a oscal:Part ;
    oscal:id "ID.AM-07.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Inventories of data and associated metadata shall be maintained for designated data types." .

<https://cyfun.eu/resource/part/ID.AM-08.10_smt> a oscal:Part ;
    oscal:id "ID.AM-08.10_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall verify security controls following maintenance or repairs/patching, and take action as appropriate." .

<https://cyfun.eu/resource/part/ID.AM-08.11_smt> a oscal:Part ;
    oscal:id "ID.AM-08.11_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Remote maintenance and diagnostic activities of organisational assets shall be pre-approved and the performance logged." .

<https://cyfun.eu/resource/part/ID.AM-08.12_smt> a oscal:Part ;
    oscal:id "ID.AM-08.12_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Setting up non-local maintenance and diagnostic sessions over remote network connections shall require strong authenticators and these connections shall be terminated when non-local maintenance is completed." .

<https://cyfun.eu/resource/part/ID.AM-08.13_smt> a oscal:Part ;
    oscal:id "ID.AM-08.13_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall require remote maintenance diagnostic services to be performed from a system that implements security features similar to the security features implemented on the equivalent organisation's critical system." .

<https://cyfun.eu/resource/part/ID.AM-08.2_smt> a oscal:Part ;
    oscal:id "ID.AM-08.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Patches and security updates for operating systems and critical system components shall be installed." .

<https://cyfun.eu/resource/part/ID.AM-08.3_smt> a oscal:Part ;
    oscal:id "ID.AM-08.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall enforce accountability for all its business-critical assets throughout the system lifecycle, including removal, transfers, and disposal." .

<https://cyfun.eu/resource/part/ID.AM-08.4_smt> a oscal:Part ;
    oscal:id "ID.AM-08.4_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall ensure that the necessary measures are taken to deal with loss, misuse, damage, or theft of assets." .

<https://cyfun.eu/resource/part/ID.AM-08.5_smt> a oscal:Part ;
    oscal:id "ID.AM-08.5_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall ensure that disposal actions are approved, tracked, documented, and verified." .

<https://cyfun.eu/resource/part/ID.AM-08.6_smt> a oscal:Part ;
    oscal:id "ID.AM-08.6_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall plan, perform and document preventive maintenance and repairs on its critical system components according to approved processes and tools." .

<https://cyfun.eu/resource/part/ID.AM-08.7_smt> a oscal:Part ;
    oscal:id "ID.AM-08.7_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation should prevent unauthorised removal of maintenance equipment which contains critical system information of the organisation." .

<https://cyfun.eu/resource/part/ID.AM-08.8_smt> a oscal:Part ;
    oscal:id "ID.AM-08.8_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation should pre-approve, monitor and enforce maintenance tools for use on its critical systems." .

<https://cyfun.eu/resource/part/ID.AM-08.9_smt> a oscal:Part ;
    oscal:id "ID.AM-08.9_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Maintenance tools and portable storage devices shall be inspected as they enter the facility and shall be protected by anti-malware solutions that scan them for malicious code before they are used on the organisation's systems." .

<https://cyfun.eu/resource/part/ID.AM-5.1_smt> a oscal:Part ;
    oscal:id "ID.AM-5.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation’s assets shall be prioritised based on classification, criticality, and business value." .

<https://cyfun.eu/resource/part/ID.AM-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "Assets (e.g., data, hardware, software, systems, facilities, services, people) that enable the organisation to achieve business purposes are identified and managed consistent with their relative importance to organisational objectives and the organisation's risk strategy." .

<https://cyfun.eu/resource/part/ID.IM-02.1_smt> a oscal:Part ;
    oscal:id "ID.IM-02.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Security tests and exercises, including those conducted with suppliers and relevant third parties, shall be used to identify areas for improvement." .

<https://cyfun.eu/resource/part/ID.IM-03.1_smt> a oscal:Part ;
    oscal:id "ID.IM-03.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall conduct risk assessments in which risk is determined by threats, vulnerabilities and the impact on business processes and assets." .

<https://cyfun.eu/resource/part/ID.IM-03.2_smt> a oscal:Part ;
    oscal:id "ID.IM-03.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall incorporate lessons learned from incident handling activities into updated or new incident handling processes and/or procedures that are framed by appropriate training after review, approval and testing." .

<https://cyfun.eu/resource/part/ID.IM-03.3_smt> a oscal:Part ;
    oscal:id "ID.IM-03.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall identify improvements derived from the monitoring, measurements, assessments, and lessons learned and consequently translate this into improved processes / procedures / technologies to enhance its cyber resilience (continuous improvement)." .

<https://cyfun.eu/resource/part/ID.IM-03.4_smt> a oscal:Part ;
    oscal:id "ID.IM-03.4_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall collaborate and share information about its critical system's related security incidents and mitigation measures with designated partners." .

<https://cyfun.eu/resource/part/ID.IM-03.5_smt> a oscal:Part ;
    oscal:id "ID.IM-03.5_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Communication of effectiveness of protection technologies shall be shared with relevant stakeholders." .

<https://cyfun.eu/resource/part/ID.IM-03.6_smt> a oscal:Part ;
    oscal:id "ID.IM-03.6_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall implement, where feasible, automated mechanisms to facilitate the process of information sharing and collaboration." .

<https://cyfun.eu/resource/part/ID.IM-03.7_smt> a oscal:Part ;
    oscal:id "ID.IM-03.7_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall implement independent teams to assess its processes, best practices, and technology solutions to safeguard critical systems and assets." .

<https://cyfun.eu/resource/part/ID.IM-03.8_smt> a oscal:Part ;
    oscal:id "ID.IM-03.8_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall ensure that the security plan for its critical systems facilitates the review, testing, and continual improvement of the security protection processes." .

<https://cyfun.eu/resource/part/ID.IM-03.9_smt> a oscal:Part ;
    oscal:id "ID.IM-03.9_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall conduct specialised assessments including in-depth monitoring, vulnerability scanning, malicious user testing, insider threat assessment, performance/load testing, and verification and validation testing on the organisation's critical systems." .

<https://cyfun.eu/resource/part/ID.IM-04.1_smt> a oscal:Part ;
    oscal:id "ID.IM-04.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Contingency and continuity plans shall be established, communicated, maintained, tested, validated, and improved." .

<https://cyfun.eu/resource/part/ID.IM-04.2_smt> a oscal:Part ;
    oscal:id "ID.IM-04.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall coordinate the development and testing of Incident Response Plans and other cybersecurity plans that affect operations with stakeholders to ensure that these plans align with overall organisational goals and enhance resilience." .

<https://cyfun.eu/resource/part/ID.IM-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "Improvements to organisational cybersecurity risk management processes, procedures and activities are identified across all CyFun® functions." .

<https://cyfun.eu/resource/part/ID.RA-01.1_smt> a oscal:Part ;
    oscal:id "ID.RA-01.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Threats and vulnerabilities shall be identified in all relevant assets, including software, network and system architectures, and facilities that house critical computing assets." .

<https://cyfun.eu/resource/part/ID.RA-01.2_smt> a oscal:Part ;
    oscal:id "ID.RA-01.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "A process shall be established to continuously monitor, identify, and document vulnerabilities of the organisation's business critical systems." .

<https://cyfun.eu/resource/part/ID.RA-01.3_smt> a oscal:Part ;
    oscal:id "ID.RA-01.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall establish and maintain a documented process that enables continuous review, analysis and remediation of vulnerabilities and makes information sharing possible, where applicable." .

<https://cyfun.eu/resource/part/ID.RA-01.4_smt> a oscal:Part ;
    oscal:id "ID.RA-01.4_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "To ensure that organisation's operations are not adversely affected by the testing process, performance/load testing and penetration testing on the organisation’s systems shall be carried out with care." .

<https://cyfun.eu/resource/part/ID.RA-01.5_smt> a oscal:Part ;
    oscal:id "ID.RA-01.5_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Vulnerability scanning shall not adversely impact system functions." .

<https://cyfun.eu/resource/part/ID.RA-01.6_smt> a oscal:Part ;
    oscal:id "ID.RA-01.6_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Vulnerabilities shall be identified and managed in all relevant assets, including software, network and system architectures, and facilities." .

<https://cyfun.eu/resource/part/ID.RA-02.1_smt> a oscal:Part ;
    oscal:id "ID.RA-02.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "A threat and vulnerability awareness programme that includes a cross-organisation information-sharing capability shall be implemented." .

<https://cyfun.eu/resource/part/ID.RA-02.2_smt> a oscal:Part ;
    oscal:id "ID.RA-02.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Automated mechanisms shall be implemented to disseminate security alerts and advisories to relevant organisation stakeholders." .

<https://cyfun.eu/resource/part/ID.RA-03.1_smt> a oscal:Part ;
    oscal:id "ID.RA-03.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Threats shall be identified and assessed in relation to all relevant assets, including software, network and system architectures, and facilities." .

<https://cyfun.eu/resource/part/ID.RA-05.1_smt> a oscal:Part ;
    oscal:id "ID.RA-05.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall conduct risk assessments in which risk is determined by threats, vulnerabilities and the impact on business processes and assets." .

<https://cyfun.eu/resource/part/ID.RA-05.2_smt> a oscal:Part ;
    oscal:id "ID.RA-05.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall conduct and document risk assessments in which risk is determined by threats, vulnerabilities, impact on business processes and assets, and likelihood of their occurrence." .

<https://cyfun.eu/resource/part/ID.RA-05.3_smt> a oscal:Part ;
    oscal:id "ID.RA-05.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Risk assessment results shall be disseminated to relevant stakeholders." .

<https://cyfun.eu/resource/part/ID.RA-06.1_smt> a oscal:Part ;
    oscal:id "ID.RA-06.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Risk responses shall be identified, prioritised, planned, tracked and communicated." .

<https://cyfun.eu/resource/part/ID.RA-08.1_smt> a oscal:Part ;
    oscal:id "ID.RA-08.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall establish and implement a vulnerability management plan to identify, analyse, assess, mitigate and communicate all types of vulnerabilities including in the form of a Coordinated Vulnerability Disclosure (CVD) according to applicable legal modalities." .

<https://cyfun.eu/resource/part/ID.RA-08.2_smt> a oscal:Part ;
    oscal:id "ID.RA-08.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall implement automated mechanisms for disseminating and tracking remedial measures related to vulnerability information that automatically handles vulnerability data collection, disseminates information, tracks remedial measures, includes reporting and accountability, and enables continuous monitoring." .

<https://cyfun.eu/resource/part/ID.RA-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "The cybersecurity risk to the organisation, assets, and individuals is understood by the organisation." .

<https://cyfun.eu/resource/part/PR.AA-01.1_smt> a oscal:Part ;
    oscal:id "PR.AA-01.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Identities and credentials for authorised users, services, and hardware shall be managed." .

<https://cyfun.eu/resource/part/PR.AA-01.2_smt> a oscal:Part ;
    oscal:id "PR.AA-01.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Identities and credentials for authorised users, services and hardware shall be managed through automated mechanisms whenever feasible." .

<https://cyfun.eu/resource/part/PR.AA-01.3_smt> a oscal:Part ;
    oscal:id "PR.AA-01.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "System credentials shall be deactivated following a specified period of inactivity, unless this would compromise the safe operation of (critical) processes." .

<https://cyfun.eu/resource/part/PR.AA-01.4_smt> a oscal:Part ;
    oscal:id "PR.AA-01.4_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "For transactions within the organisation's critical systems, the organisation shall implement Multi Factor Authentication (MFA), cryptographic certificates, identity tokens, cryptographic keys and other credentials as appropriate and where feasible." .

<https://cyfun.eu/resource/part/PR.AA-01.5_smt> a oscal:Part ;
    oscal:id "PR.AA-01.5_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation’s critical systems shall be monitored for atypical use of system credentials. Credentials associated with significant risk shall be disabled." .

<https://cyfun.eu/resource/part/PR.AA-02.1_smt> a oscal:Part ;
    oscal:id "PR.AA-02.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall implement documented procedures for verifying the identity of individuals before issuing credentials that provide access to the organisation's systems." .

<https://cyfun.eu/resource/part/PR.AA-02.2_smt> a oscal:Part ;
    oscal:id "PR.AA-02.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "TThe organisation shall ensure that unique credentials are used for each authenticated user, device, and process interacting with the organisation's critical systems. These credentials shall be verified, and the unique identifiers shall be captured during system interactions. Exceptions may be made for emergency access (\"break-glass\" procedures), provided such access is strictly controlled, logged, and reviewed." .

<https://cyfun.eu/resource/part/PR.AA-03.1_smt> a oscal:Part ;
    oscal:id "PR.AA-03.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "All wireless access points used by the organisation, including those providing guest access, shall be securely configured, managed, and monitored to prevent unauthorised access and ensure network integrity." .

<https://cyfun.eu/resource/part/PR.AA-03.2_smt> a oscal:Part ;
    oscal:id "PR.AA-03.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Multi-Factor Authentication (MFA) shall be required to access the organisation's networks remotely." .

<https://cyfun.eu/resource/part/PR.AA-03.3_smt> a oscal:Part ;
    oscal:id "PR.AA-03.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall define, document, and implement usage restrictions, connection requirements, and authorisation procedures for remote access to its critical systems. These controls shall ensure that only approved users can connect, using secure methods, with access limited to what is necessary for their role." .

<https://cyfun.eu/resource/part/PR.AA-03.4_smt> a oscal:Part ;
    oscal:id "PR.AA-03.4_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Remote access to the organisation’s critical systems shall be monitored and cryptographic mechanisms shall be implemented where determined necessary." .

<https://cyfun.eu/resource/part/PR.AA-03.5_smt> a oscal:Part ;
    oscal:id "PR.AA-03.5_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The security for connections with external systems shall be verified and framed by documented agreements." .

<https://cyfun.eu/resource/part/PR.AA-04.1_smt> a oscal:Part ;
    oscal:id "PR.AA-04.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Identity assertions are protected, conveyed, and verified." .

<https://cyfun.eu/resource/part/PR.AA-05.1_smt> a oscal:Part ;
    oscal:id "PR.AA-05.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Access permissions, rights, and authorisations shall be defined, managed, enforced and reviewed." .

<https://cyfun.eu/resource/part/PR.AA-05.2_smt> a oscal:Part ;
    oscal:id "PR.AA-05.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "It shall be determined who needs access to the organisation's business-critical information and technology and the means to gain access." .

<https://cyfun.eu/resource/part/PR.AA-05.3_smt> a oscal:Part ;
    oscal:id "PR.AA-05.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Access rights, privileges and authorisations must be restricted to the systems and specific information needed to perform the tasks (the principle of Least Privilege)." .

<https://cyfun.eu/resource/part/PR.AA-05.4_smt> a oscal:Part ;
    oscal:id "PR.AA-05.4_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "No-one shall have administrative privileges for routine day-to-day tasks." .

<https://cyfun.eu/resource/part/PR.AA-05.5_smt> a oscal:Part ;
    oscal:id "PR.AA-05.5_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Where technically, operationally, and economically feasible—without compromising system integrity, safety, or compliance—automated mechanisms shall be implemented to manage user accounts on critical ICT and OT systems. Feasibility shall be determined based on system capabilities, integration potential, risk assessment, and business impact." .

<https://cyfun.eu/resource/part/PR.AA-05.6_smt> a oscal:Part ;
    oscal:id "PR.AA-05.6_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Separation of duties (SoD) shall be ensured in the management of access rights." .

<https://cyfun.eu/resource/part/PR.AA-05.7_smt> a oscal:Part ;
    oscal:id "PR.AA-05.7_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Privileged users shall be managed and monitored." .

<https://cyfun.eu/resource/part/PR.AA-05.8_smt> a oscal:Part ;
    oscal:id "PR.AA-05.8_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Account usage restrictions for specific time periods and locations shall be taken into account in the organisation's security access policy and applied accordingly." .

<https://cyfun.eu/resource/part/PR.AA-05.9_smt> a oscal:Part ;
    oscal:id "PR.AA-05.9_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Privileged users shall be managed, monitored and audited." .

<https://cyfun.eu/resource/part/PR.AA-06.1_smt> a oscal:Part ;
    oscal:id "PR.AA-06.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Physical access to all organisational assets, including critical zones, should be managed, monitored, and enforced based on risk." .

<https://cyfun.eu/resource/part/PR.AA-06.2_smt> a oscal:Part ;
    oscal:id "PR.AA-06.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Physical access controls should include specific procedures for emergency situations, ensuring continued protection of critical and non-critical assets during such events." .

<https://cyfun.eu/resource/part/PR.AA-06.3_smt> a oscal:Part ;
    oscal:id "PR.AA-06.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Critical zones should have additional physical access controls beyond those applied to general facilities." .

<https://cyfun.eu/resource/part/PR.AA-06.4_smt> a oscal:Part ;
    oscal:id "PR.AA-06.4_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Assets located within critical zones should be physically protected against unauthorised access, damage, or interference." .

<https://cyfun.eu/resource/part/PR.AA-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "Access to physical and logical assets is limited to authorised users, services, and hardware and managed commensurate with the assessed risk of unauthorised access." .

<https://cyfun.eu/resource/part/PR.AT-01.1_smt> a oscal:Part ;
    oscal:id "PR.AT-01.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall establish and maintain a cybersecurity awareness and training programme to ensure that all personnel understand how to perform their tasks securely and responsibly." .

<https://cyfun.eu/resource/part/PR.AT-01.2_smt> a oscal:Part ;
    oscal:id "PR.AT-01.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall include insider threat awareness and reporting in its cybersecurity training to help personnel recognise and respond to potential internal risks." .

<https://cyfun.eu/resource/part/PR.AT-01.3_smt> a oscal:Part ;
    oscal:id "PR.AT-01.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Personnel shall receive training to understand their specific roles, responsibilities, and priorities during a cybersecurity or information security incident, including the steps they need to follow to respond effectively." .

<https://cyfun.eu/resource/part/PR.AT-01.4_smt> a oscal:Part ;
    oscal:id "PR.AT-01.4_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall evaluate whether its cybersecurity awareness training is effective in improving knowledge, behaviour, and readiness across the organisation." .

<https://cyfun.eu/resource/part/PR.AT-02.1_smt> a oscal:Part ;
    oscal:id "PR.AT-02.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Members of management bodies shall be able to demonstrate that they have completed training that gives them a solid understanding of information and cybersecurity and risk management so that they can assess information and cyber security risks and their consequences and propose the necessary risk mitigation, considering their roles, responsibilities and authorities." .

<https://cyfun.eu/resource/part/PR.AT-02.2_smt> a oscal:Part ;
    oscal:id "PR.AT-02.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Individuals in specialised roles shall be provided with awareness and training before privileges are granted, so that they possess the knowledge and skills to perform relevant tasks with cybersecurity risks in mind." .

<https://cyfun.eu/resource/part/PR.AT-02.3_smt> a oscal:Part ;
    oscal:id "PR.AT-02.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Privileged users shall be qualified before privileges are granted, and these users shall be able to demonstrate the understanding of their roles, responsibilities, and authorities." .

<https://cyfun.eu/resource/part/PR.AT-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "The organisation's personnel are provided with cybersecurity awareness and training, so that they can perform their cybersecurity-related tasks" .

<https://cyfun.eu/resource/part/PR.DS-01.1_smt> a oscal:Part ;
    oscal:id "PR.DS-01.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall implement software, firmware, and information integrity checks to detect unauthorised changes to its critical system components during storage, transport, start-up and when determined necessary." .

<https://cyfun.eu/resource/part/PR.DS-01.2_smt> a oscal:Part ;
    oscal:id "PR.DS-01.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall implement automated tools where feasible to provide notification upon discovering discrepancies during integrity verification." .

<https://cyfun.eu/resource/part/PR.DS-01.3_smt> a oscal:Part ;
    oscal:id "PR.DS-01.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall define and implement automated responses to detected integrity violations, using predefined safeguards that are proportionate to the severity and impact of the violation." .

<https://cyfun.eu/resource/part/PR.DS-01.4_smt> a oscal:Part ;
    oscal:id "PR.DS-01.4_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall define and enforce clear policies and practical safeguards to manage and restrict the use of portable storage media, in order to reduce the risk of data leakage, unauthorised access, and malware introduction." .

<https://cyfun.eu/resource/part/PR.DS-01.5_smt> a oscal:Part ;
    oscal:id "PR.DS-01.5_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall only allow the use of removable media when absolutely necessary, and shall put technical measures in place to block automatic execution of files from these devices." .

<https://cyfun.eu/resource/part/PR.DS-01.6_smt> a oscal:Part ;
    oscal:id "PR.DS-01.6_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall protect the confidentiality of its critical assets while at rest." .

<https://cyfun.eu/resource/part/PR.DS-01.9_smt> a oscal:Part ;
    oscal:id "PR.DS-01.9_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Enterprise assets shall be disposed of safely." .

<https://cyfun.eu/resource/part/PR.DS-02.1_smt> a oscal:Part ;
    oscal:id "PR.DS-02.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Portable storage devices containing system data shall be controlled and protected while in transit and in storage." .

<https://cyfun.eu/resource/part/PR.DS-02.2_smt> a oscal:Part ;
    oscal:id "PR.DS-02.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall protect its critical and sensitive information while in transit." .

<https://cyfun.eu/resource/part/PR.DS-10.1_smt> a oscal:Part ;
    oscal:id "PR.DS-10.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation’s critical systems shall be protected against denial-of-service attacks or at least the effect of such attacks shall be limited." .

<https://cyfun.eu/resource/part/PR.DS-11.1_smt> a oscal:Part ;
    oscal:id "PR.DS-11.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Backups for the organisation's business critical data shall be performed and stored on a different system from the device on which the original data resides." .

<https://cyfun.eu/resource/part/PR.DS-11.2_smt> a oscal:Part ;
    oscal:id "PR.DS-11.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The reliability and integrity of backups shall be verified and tested regularly." .

<https://cyfun.eu/resource/part/PR.DS-11.3_smt> a oscal:Part ;
    oscal:id "PR.DS-11.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall maintain secure backups of business-critical data in a separate storage location to ensure data availability in case of system failure or data loss. Backup storage shall apply equivalent security controls as the primary environment." .

<https://cyfun.eu/resource/part/PR.DS-11.4_smt> a oscal:Part ;
    oscal:id "PR.DS-11.4_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall regularly verify the integrity and recoverability of backups through coordinated testing with all relevant continuity and incident response functions. Backup testing shall be integrated into broader resilience planning, including business continuity, disaster recovery, and cyber incident response." .

<https://cyfun.eu/resource/part/PR.DS-11.5_smt> a oscal:Part ;
    oscal:id "PR.DS-11.5_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Backups of critical systems (such as operating systems, configurations, and applications) shall be kept separate from backups of critical information (such as business data, documents, and databases) to support faster and more reliable recovery." .

<https://cyfun.eu/resource/part/PR.DS-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "Data are managed consistent with the organisation's risk strategy to protect the confidentiality, integrity, and availability of information" .

<https://cyfun.eu/resource/part/PR.IR-01.1_smt> a oscal:Part ;
    oscal:id "PR.IR-01.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Firewalls shall be installed, configured, and actively maintained on all networks used by the organisation to protect against unauthorised access and cyber threats." .

<https://cyfun.eu/resource/part/PR.IR-01.2_smt> a oscal:Part ;
    oscal:id "PR.IR-01.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "To safeguard critical systems, organisations shall implement network segmentation and segregation aligned with trust boundaries and asset criticality, thereby limiting threat propagation and enforcing strict access control." .

<https://cyfun.eu/resource/part/PR.IR-01.3_smt> a oscal:Part ;
    oscal:id "PR.IR-01.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "To ensure operational stability and security, the organisation shall, without exception, identify, document, and control connections between components of its critical systems." .

<https://cyfun.eu/resource/part/PR.IR-01.4_smt> a oscal:Part ;
    oscal:id "PR.IR-01.4_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall implement appropriate boundary protection measures to monitor and control communications at external and key internal boundaries of its critical systems, across both IT and OT environments, to ensure secure and reliable operations." .

<https://cyfun.eu/resource/part/PR.IR-01.5_smt> a oscal:Part ;
    oscal:id "PR.IR-01.5_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall implement, where feasible, authenticated proxy servers or firewalls with URL filtering and threat intelligence capabilities for defined communications traffic between its critical systems and external networks." .

<https://cyfun.eu/resource/part/PR.IR-01.6_smt> a oscal:Part ;
    oscal:id "PR.IR-01.6_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall ensure that its critical systems are designed to fail securely and remain protected in the event of an operational failure of a border protection device." .

<https://cyfun.eu/resource/part/PR.IR-01.7_smt> a oscal:Part ;
    oscal:id "PR.IR-01.7_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall ensure that development and test environments are strictly separated from the production environment, particularly in ICS/OT systems where any crossover could compromise security, endanger health, or disrupt essential operations." .

<https://cyfun.eu/resource/part/PR.IR-01.8_smt> a oscal:Part ;
    oscal:id "PR.IR-01.8_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall define, monitor, and control the flow of information and data within and between its critical systems to ensure that only authorised and secure exchanges occur, regardless of network boundaries or system architecture." .

<https://cyfun.eu/resource/part/PR.IR-01.9_smt> a oscal:Part ;
    oscal:id "PR.IR-01.9_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall manage interfaces with external telecommunications services as part of its broader network security policy, by defining how traffic is controlled, ensuring the confidentiality and integrity of transmitted information, and reviewing and documenting any exceptions to established rules." .

<https://cyfun.eu/resource/part/PR.IR-02.1_smt> a oscal:Part ;
    oscal:id "PR.IR-02.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall define, implement and maintain policies and procedures related to emergency and safety systems, fire protection systems and environmental controls for its critical systems." .

<https://cyfun.eu/resource/part/PR.IR-02.2_smt> a oscal:Part ;
    oscal:id "PR.IR-02.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall implement fire detection devices that activate and notify key personnel automatically in the event of a fire." .

<https://cyfun.eu/resource/part/PR.IR-03.1_smt> a oscal:Part ;
    oscal:id "PR.IR-03.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall implement mechanisms to ensure that critical systems and services remain operational or can be quickly restored during both normal operations and adverse conditions." .

<https://cyfun.eu/resource/part/PR.IR-04.1_smt> a oscal:Part ;
    oscal:id "PR.IR-04.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Adequate resource capacity planning shall ensure that availability of organisation's critical system information processing, networking, telecommunications, and data storage is maintained." .

<https://cyfun.eu/resource/part/PR.IR-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "Security architectures are managed with the organisation's risk strategy to protect asset confidentiality, integrity, and availability, and organisational resilience." .

<https://cyfun.eu/resource/part/PR.PS-01.1_smt> a oscal:Part ;
    oscal:id "PR.PS-01.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall develop, document, and maintain a baseline configuration for its business-critical systems." .

<https://cyfun.eu/resource/part/PR.PS-01.2_smt> a oscal:Part ;
    oscal:id "PR.PS-01.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall configure its business-critical systems to operate with only the essential functions needed for the intended purpose. This includes reviewing and updating baseline configurations to disable any non-essential capabilities." .

<https://cyfun.eu/resource/part/PR.PS-01.3_smt> a oscal:Part ;
    oscal:id "PR.PS-01.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall identify and disable specific functions, ports, protocols, and services within its critical systems that are not required for business operations." .

<https://cyfun.eu/resource/part/PR.PS-01.4_smt> a oscal:Part ;
    oscal:id "PR.PS-01.4_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall implement technical safeguards to enforce a policy of ‘deny-all’ and ‘permit-by-exception’ so that only authorised software programmes are executed." .

<https://cyfun.eu/resource/part/PR.PS-01.5_smt> a oscal:Part ;
    oscal:id "PR.PS-01.5_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Unauthorised configuration changes to organisation's systems shall be monitored and addressed with the appropriate mitigation actions." .

<https://cyfun.eu/resource/part/PR.PS-02.1_smt> a oscal:Part ;
    oscal:id "PR.PS-02.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall enforce restrictions on software usage and installation, and ensure that software is maintained, replaced, or removed based on its associated risk." .

<https://cyfun.eu/resource/part/PR.PS-03.1_smt> a oscal:Part ;
    oscal:id "PR.PS-03.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Hardware used in business-critical environments shall be maintained, replaced, or removed based on its associated security and operational risk." .

<https://cyfun.eu/resource/part/PR.PS-04.1_smt> a oscal:Part ;
    oscal:id "PR.PS-04.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Logs shall be maintained, documented, and rmonitored." .

<https://cyfun.eu/resource/part/PR.PS-04.2_smt> a oscal:Part ;
    oscal:id "PR.PS-04.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall ensure that logbook records contain an authoritative time source or internal clock time stamp that is compared and synchronised with an authoritative time source." .

<https://cyfun.eu/resource/part/PR.PS-04.3_smt> a oscal:Part ;
    oscal:id "PR.PS-04.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Audit data from the organisation's critical systems shall be moved to an alternative system." .

<https://cyfun.eu/resource/part/PR.PS-04.4_smt> a oscal:Part ;
    oscal:id "PR.PS-04.4_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall ensure that audit processing failures on the organisation's systems generate alerts and trigger defined responses." .

<https://cyfun.eu/resource/part/PR.PS-04.5_smt> a oscal:Part ;
    oscal:id "PR.PS-04.5_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall ensure that authorised personnel can extend or enhance audit logging and monitoring capabilities when needed to support investigations or incident response." .

<https://cyfun.eu/resource/part/PR.PS-05.1_smt> a oscal:Part ;
    oscal:id "PR.PS-05.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Web and e-mail filters shall be installed and used." .

<https://cyfun.eu/resource/part/PR.PS-05.2_smt> a oscal:Part ;
    oscal:id "PR.PS-05.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Installation and execution of unauthorised software shall be prevented." .

<https://cyfun.eu/resource/part/PR.PS-06-4_smt> a oscal:Part ;
    oscal:id "PR.PS-06-4_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "For planned changes to the organisation's critical systems, a security impact analysis shall be performed in a separate test environment before implementation in an operational environment." .

<https://cyfun.eu/resource/part/PR.PS-06.1_smt> a oscal:Part ;
    oscal:id "PR.PS-06.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Security shall be considered throughout the lifecycle of systems and applications, whether developed internally or acquired externally." .

<https://cyfun.eu/resource/part/PR.PS-06.2_smt> a oscal:Part ;
    oscal:id "PR.PS-06.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Changes and exceptions shall be tested and validated before being implemented into operational systems." .

<https://cyfun.eu/resource/part/PR.PS-06.3_smt> a oscal:Part ;
    oscal:id "PR.PS-06.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Secure software development practices shall be integrated into all phases of the software development lifecycle, and their effectiveness should be regularly monitored and improved." .

<https://cyfun.eu/resource/part/PR.PS-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "The hardware, software (e.g., firmware, operating systems, applications), and services of physical and virtual platforms are managed consistent with the organisation's risk strategy to protect their confidentiality, integrity, and availability." .

<https://cyfun.eu/resource/part/RC.CO-03.1_smt> a oscal:Part ;
    oscal:id "RC.CO-03.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Recovery activities and progress in restoring operational capabilities shall be communicated to designated internal and external stakeholders in accordance with established communication procedures." .

<https://cyfun.eu/resource/part/RC.CO-04.1_smt> a oscal:Part ;
    oscal:id "RC.CO-04.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Public updates on incident recovery shall be shared using approved communication methods and messaging, in accordance with established procedures." .

<https://cyfun.eu/resource/part/RC.CO-04.2_smt> a oscal:Part ;
    oscal:id "RC.CO-04.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall assign a Public Relations Officer (PRO) to manage public communications during information/cybersecurity incident recovery, ensuring that public updates are shared while maintaining the confidentiality, integrity, and accuracy of the information." .

<https://cyfun.eu/resource/part/RC.CO-04.3_smt> a oscal:Part ;
    oscal:id "RC.CO-04.3_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall implement a crisis communication strategy to mitigate negative impacts during a crisis and help restore its reputation afterward." .

<https://cyfun.eu/resource/part/RC.CO-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "Restoration activities are coordinated with internal and external parties." .

<https://cyfun.eu/resource/part/RC.RP-01.1_smt> a oscal:Part ;
    oscal:id "RC.RP-01.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "A recovery process for disasters and information/cybersecurity incidents shall be developed and executed." .

<https://cyfun.eu/resource/part/RC.RP-02.1_smt> a oscal:Part ;
    oscal:id "RC.RP-02.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation's essential functions and services shall be continued with little or no loss of operational continuity, and continuity shall be maintained until full system recovery." .

<https://cyfun.eu/resource/part/RC.RP-05.1_smt> a oscal:Part ;
    oscal:id "RC.RP-05.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The integrity of restored systems and assets shall be verified before they are returned to service. Systems and services shall be fully restored, and normal operations shall be confirmed." .

<https://cyfun.eu/resource/part/RC.RP-06.1_smt> a oscal:Part ;
    oscal:id "RC.RP-06.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The end of incident recovery shall be formally declared based on predefined criteria, and all incident-related documentation shall be completed and reviewed." .

<https://cyfun.eu/resource/part/RC.RP-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "Restoration activities are performed to ensure operational availability of systems and services affected by cybersecurity incidents." .

<https://cyfun.eu/resource/part/RS.AN-03.1_smt> a oscal:Part ;
    oscal:id "RS.AN-03.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Each incident shall be analysed to determine what occurred and to identify its root cause." .

<https://cyfun.eu/resource/part/RS.AN-06.1_smt> a oscal:Part ;
    oscal:id "RS.AN-06.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Actions performed during an investigation shall be recorded, and the records' integrity and provenance shall be preserved." .

<https://cyfun.eu/resource/part/RS.AN-07.1_smt> a oscal:Part ;
    oscal:id "RS.AN-07.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Incident data and metadata should be collected and protected to ensure their accuracy, authenticity, and traceability." .

<https://cyfun.eu/resource/part/RS.AN-08.1_smt> a oscal:Part ;
    oscal:id "RS.AN-08.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "An incident’s magnitude shall be estimated and validated." .

<https://cyfun.eu/resource/part/RS.AN-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "Investigations are conducted to ensure effective response and support forensics and recovery activities." .

<https://cyfun.eu/resource/part/RS.CO-02.1_smt> a oscal:Part ;
    oscal:id "RS.CO-02.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Information about cybersecurity incidents shall be communicated to employees in a way that is clear and easy to understand." .

<https://cyfun.eu/resource/part/RS.CO-02.2_smt> a oscal:Part ;
    oscal:id "RS.CO-02.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Cybersecurity incidents shall be shared with relevant external stakeholders within the timeframes defined in the Incident Response Plan, including reporting significant incidents to authorities as required by law." .

<https://cyfun.eu/resource/part/RS.CO-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "Response activities are coordinated with internal and external stakeholders as required by laws, regulations, or policies." .

<https://cyfun.eu/resource/part/RS.MA-01.1_smt> a oscal:Part ;
    oscal:id "RS.MA-01.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "An incident response plan, including defined roles, responsibilities, and authorities, shall be executed during or after a cybersecurity event affecting the organisation's critical systems." .

<https://cyfun.eu/resource/part/RS.MA-01.2_smt> a oscal:Part ;
    oscal:id "RS.MA-01.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall coordinate information/cybersecurity incident response actions with all predefined stakeholders." .

<https://cyfun.eu/resource/part/RS.MA-02.1_smt> a oscal:Part ;
    oscal:id "RS.MA-02.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Information/cybersecurity incident reports shall be triaged and validated in accordance with the organisation’s incident response procedures." .

<https://cyfun.eu/resource/part/RS.MA-02.2_smt> a oscal:Part ;
    oscal:id "RS.MA-02.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Automated tools shall be used to support the investigation and impact assessment of validated cybersecurity incidents." .

<https://cyfun.eu/resource/part/RS.MA-03.1_smt> a oscal:Part ;
    oscal:id "RS.MA-03.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Information/cybersecurity incidents shall be categorised, prioritised and escalated as specified in the incident response plan." .

<https://cyfun.eu/resource/part/RS.MA-05.1_smt> a oscal:Part ;
    oscal:id "RS.MA-05.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Clear criteria shall be defined and applied to determine when incident recovery processes need to be initiated." .

<https://cyfun.eu/resource/part/RS.MA-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "Responses to detected cybersecurity incidents are managed." .

<https://cyfun.eu/resource/part/RS.MI-01.1_smt> a oscal:Part ;
    oscal:id "RS.MI-01.1_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "Cybersecurity incidents shall be contained and eliminated. Any decision to accept and retain certain cybersecurity risks shall be formally documented." .

<https://cyfun.eu/resource/part/RS.MI-01.2_smt> a oscal:Part ;
    oscal:id "RS.MI-01.2_smt" ;
    oscal:index 1 ;
    oscal:name "statement" ;
    oscal:prose "The organisation shall detect unauthorised access or data leakage and take appropriate mitigation actions, including monitoring of critical systems at external boundaries and key internal points." .

<https://cyfun.eu/resource/part/RS.MI-part-1> a oscal:Part ;
    oscal:index 1 ;
    oscal:name "overview" ;
    oscal:prose "Activities are performed to prevent expansion of an event and mitigate its effects." .

