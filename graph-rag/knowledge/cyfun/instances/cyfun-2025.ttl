    oscal:value "04-002-007-019" .

<https://cyfun.eu/resource/property/DE.AE-03.3-3> a oscal:Property ;
    oscal:index 3 ;
    oscal:name "assurance-level" ;
    oscal:ns <http://cyfun.eu/ns/oscal> ;
