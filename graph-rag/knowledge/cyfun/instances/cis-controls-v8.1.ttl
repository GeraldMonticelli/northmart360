@prefix cis: <https://example.org/cis-controls-v8.1/> .
@prefix ciso: <https://example.org/cis-controls-v8.1/ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cis:1.1 a ciso:Safeguard ;
    rdfs:label "Establish and Maintain Detailed Enterprise Asset Inventory" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-devices ;
    ciso:belongsToControl cis:1 ;
    ciso:description "Establish and maintain an accurate, detailed, and up-to-date inventory of all enterprise assets with the potential to store or process data, to include: end-user devices (including portable and mobile), network devices, non-computing/IoT devices, and servers. Ensure the inventory records the network address (if static), hardware address, machine name, enterprise asset owner, department for each asset, and whether the asset has been approved to connect to the network. For mobile end-user devices, MDM type tools can support this process, where appropriate. This inventory includes assets connected to the infrastructure physically, virtually, remotely, and those within cloud environments. Additionally, it includes assets that are regularly connected to the enterprise’s network infrastructure, even if they are not under control of the enterprise. Review and update the inventory of all enterprise assets bi-annually, or more frequently." ;
    ciso:identifier "1.1" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-identify .

cis:1.2 a ciso:Safeguard ;
    rdfs:label "Address Unauthorized Assets" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-devices ;
    ciso:belongsToControl cis:1 ;
    ciso:description "Ensure that a process exists to address unauthorized assets on a weekly basis. The enterprise may choose to remove the asset from the network, deny the asset from connecting remotely to the network, or quarantine the asset." ;
    ciso:identifier "1.2" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-respond .

cis:1.3 a ciso:Safeguard ;
    rdfs:label "Utilize an Active Discovery Tool" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-devices ;
    ciso:belongsToControl cis:1 ;
    ciso:description "Utilize an active discovery tool to identify assets connected to the enterprise’s network. Configure the active discovery tool to execute daily, or more frequently." ;
    ciso:identifier "1.3" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-detect .

cis:1.4 a ciso:Safeguard ;
    rdfs:label "Use Dynamic Host Configuration Protocol (DHCP) Logging to Update" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-devices ;
    ciso:belongsToControl cis:1 ;
    ciso:description "Use DHCP logging on all DHCP servers or Internet Protocol (IP) address management tools to update the enterprise’s asset inventory. Review and use logs to update the enterprise’s asset inventory weekly, or more frequently." ;
    ciso:identifier "1.4" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-identify .

cis:1.5 a ciso:Safeguard ;
    rdfs:label "Use a Passive Asset Discovery Tool" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-devices ;
    ciso:belongsToControl cis:1 ;
    ciso:description "Use a passive discovery tool to identify assets connected to the enterprise’s network. Review and use scans to update the enterprise’s asset inventory at least weekly, or more frequently." ;
    ciso:identifier "1.5" ;
    ciso:implementationGroup cis:ig3 ;
    ciso:securityFunction cis:security-function-detect .

cis:10.1 a ciso:Safeguard ;
    rdfs:label "Deploy and Maintain Anti-Malware Software" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-devices ;
    ciso:belongsToControl cis:10 ;
    ciso:description "Deploy and maintain anti-malware software on all enterprise assets." ;
    ciso:identifier "10.1" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-detect .

cis:10.2 a ciso:Safeguard ;
    rdfs:label "Configure Automatic Anti-Malware Signature Updates" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-devices ;
    ciso:belongsToControl cis:10 ;
    ciso:description "Configure automatic updates for anti-malware signature files on all enterprise assets." ;
    ciso:identifier "10.2" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:10.3 a ciso:Safeguard ;
    rdfs:label "Disable Autorun and Autoplay for Removable Media" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-devices ;
    ciso:belongsToControl cis:10 ;
    ciso:description "Disable autorun and autoplay auto-execute functionality for removable media." ;
    ciso:identifier "10.3" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:10.4 a ciso:Safeguard ;
    rdfs:label "Configure Automatic Anti-Malware Scanning of Removable Media" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-devices ;
    ciso:belongsToControl cis:10 ;
    ciso:description "Configure anti-malware software to automatically scan removable media." ;
    ciso:identifier "10.4" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-detect .

cis:10.5 a ciso:Safeguard ;
    rdfs:label "Enable Anti-Exploitation Features" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-devices ;
    ciso:belongsToControl cis:10 ;
    ciso:description "Enable anti-exploitation features on enterprise assets and software, where possible, such as Microsoft® Data Execution Prevention (DEP), Windows® Defender Exploit Guard (WDEG), or Apple® System Integrity Protection (SIP) and Gatekeeper™." ;
    ciso:identifier "10.5" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:10.6 a ciso:Safeguard ;
    rdfs:label "Centrally Manage Anti-Malware Software" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-devices ;
    ciso:belongsToControl cis:10 ;
    ciso:description "Centrally manage anti-malware software." ;
    ciso:identifier "10.6" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:10.7 a ciso:Safeguard ;
    rdfs:label "Use Behavior-Based Anti-Malware Software" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-devices ;
    ciso:belongsToControl cis:10 ;
    ciso:description "Use behavior-based anti-malware software." ;
    ciso:identifier "10.7" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-detect .

cis:11.1 a ciso:Safeguard ;
    rdfs:label "Establish and Maintain a Data Recovery Process" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-documentation ;
    ciso:belongsToControl cis:11 ;
    ciso:description "Establish and maintain a documented data recovery process that includes detailed backup procedures. In the process, address the scope of data recovery activities, recovery prioritization, and the security of backup data. Review and update documentation annually, or when significant enterprise changes occur that could impact this Safeguard." ;
    ciso:identifier "11.1" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-govern .

cis:11.2 a ciso:Safeguard ;
    rdfs:label "Perform Automated Backups" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-data ;
    ciso:belongsToControl cis:11 ;
    ciso:description "Perform automated backups of in-scope enterprise assets. Run backups weekly, or more frequently, based on the sensitivity of the data." ;
    ciso:identifier "11.2" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-recover .

cis:11.3 a ciso:Safeguard ;
    rdfs:label "Protect Recovery Data" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-data ;
    ciso:belongsToControl cis:11 ;
    ciso:description "Protect recovery data with equivalent controls to the original data. Reference encryption or data separation, based on requirements." ;
    ciso:identifier "11.3" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:11.4 a ciso:Safeguard ;
    rdfs:label "Establish and Maintain an Isolated Instance of Recovery Data" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-data ;
    ciso:belongsToControl cis:11 ;
    ciso:description "Establish and maintain an isolated instance of recovery data. Example implementations include, version controlling backup destinations through offline, cloud, or off-site systems or services." ;
    ciso:identifier "11.4" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-recover .

cis:11.5 a ciso:Safeguard ;
    rdfs:label "Test Data Recovery" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-data ;
    ciso:belongsToControl cis:11 ;
    ciso:description "Test backup recovery quarterly, or more frequently, for a sampling of in-scope enterprise assets." ;
    ciso:identifier "11.5" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-recover .

cis:12.1 a ciso:Safeguard ;
    rdfs:label "Ensure Network Infrastructure is Up-to-Date" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-network ;
    ciso:belongsToControl cis:12 ;
    ciso:description "Ensure network infrastructure is kept up-to-date. Example implementations include running the latest stable release of software and/or using currently supported network as a service (NaaS) offerings. Review software versions monthly, or more frequently, to verify software support." ;
    ciso:identifier "12.1" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:12.2 a ciso:Safeguard ;
    rdfs:label "Establish and Maintain a Secure Network Architecture" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-network ;
    ciso:belongsToControl cis:12 ;
    ciso:description "Design and maintain a secure network architecture. A secure network architecture must address segmentation, least privilege, and availability, at a minimum. Example implementations may include documentation, policy, and design components." ;
    ciso:identifier "12.2" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:12.3 a ciso:Safeguard ;
    rdfs:label "Securely Manage Network Infrastructure" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-network ;
    ciso:belongsToControl cis:12 ;
    ciso:description "Securely manage network infrastructure. Example implementations include version-controlled- infrastructure-as-code, and the use of secure network protocols, such as SSH and HTTPS." ;
    ciso:identifier "12.3" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:12.4 a ciso:Safeguard ;
    rdfs:label "Establish and Maintain Architecture Diagram(s)" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-documentation ;
    ciso:belongsToControl cis:12 ;
    ciso:description "Establish and maintain architecture diagram(s) and/or other network system documentation. Review and update documentation annually, or when significant enterprise changes occur that could impact this Safeguard." ;
    ciso:identifier "12.4" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-govern .

cis:12.5 a ciso:Safeguard ;
    rdfs:label "Centralize Network Authentication, Authorization, and Auditing (AAA)" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-network ;
    ciso:belongsToControl cis:12 ;
    ciso:description "Centralize network AAA." ;
    ciso:identifier "12.5" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:12.6 a ciso:Safeguard ;
    rdfs:label "Use of Secure Network Management and Communication Protocols" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-network ;
    ciso:belongsToControl cis:12 ;
    ciso:description "Adopt secure network management protocols (e.g., 802.1X) and secure communication protocols (e.g., Wi-Fi Protected Access 2 (WPA2) Enterprise or more secure alternatives)." ;
    ciso:identifier "12.6" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:12.7 a ciso:Safeguard ;
    rdfs:label "Ensure Remote Devices Utilize a VPN and are Connecting to an" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-devices ;
    ciso:belongsToControl cis:12 ;
    ciso:description "Require users to authenticate to enterprise-managed VPN and authentication services prior to accessing enterprise resources on end-user devices." ;
    ciso:identifier "12.7" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:12.8 a ciso:Safeguard ;
    rdfs:label "Establish and Maintain Dedicated Computing Resources for All" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-devices ;
    ciso:belongsToControl cis:12 ;
    ciso:description "Establish and maintain dedicated computing resources, either physically or logically separated, for all administrative tasks or tasks requiring administrative access. The computing resources should be segmented from the enterprise’s primary network and not be allowed internet access." ;
    ciso:identifier "12.8" ;
    ciso:implementationGroup cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:13.1 a ciso:Safeguard ;
    rdfs:label "Centralize Security Event Alerting" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-network ;
    ciso:belongsToControl cis:13 ;
    ciso:description "Centralize security event alerting across enterprise assets for log correlation and analysis. Best practice implementation requires the use of a SIEM, which includes vendor-defined event correlation alerts. A log analytics platform configured with security-relevant correlation alerts also satisfies this Safeguard." ;
    ciso:identifier "13.1" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-detect .

cis:13.10 a ciso:Safeguard ;
    rdfs:label "Perform Application Layer Filtering" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-network ;
    ciso:belongsToControl cis:13 ;
    ciso:description "Perform application layer filtering. Example implementations include a filtering proxy, application layer firewall, or gateway." ;
    ciso:identifier "13.10" ;
    ciso:implementationGroup cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:13.11 a ciso:Safeguard ;
    rdfs:label "Tune Security Event Alerting Thresholds" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-network ;
    ciso:belongsToControl cis:13 ;
    ciso:description "Tune security event alerting thresholds monthly, or more frequently." ;
    ciso:identifier "13.11" ;
    ciso:implementationGroup cis:ig3 ;
    ciso:securityFunction cis:security-function-detect .

cis:13.2 a ciso:Safeguard ;
    rdfs:label "Deploy a Host-Based Intrusion Detection Solution" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-devices ;
    ciso:belongsToControl cis:13 ;
    ciso:description "Deploy a host-based intrusion detection solution on enterprise assets, where appropriate and/ or supported." ;
    ciso:identifier "13.2" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-detect .

cis:13.3 a ciso:Safeguard ;
    rdfs:label "Deploy a Network Intrusion Detection Solution" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-network ;
    ciso:belongsToControl cis:13 ;
    ciso:description "Deploy a network intrusion detection solution on enterprise assets, where appropriate. Example implementations include the use of a Network Intrusion Detection System (NIDS) or equivalent cloud service provider (CSP) service." ;
    ciso:identifier "13.3" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-detect .

cis:13.4 a ciso:Safeguard ;
    rdfs:label "Perform Traffic Filtering Between Network Segments" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-network ;
    ciso:belongsToControl cis:13 ;
    ciso:description "Perform traffic filtering between network segments, where appropriate." ;
    ciso:identifier "13.4" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:13.5 a ciso:Safeguard ;
    rdfs:label "Manage Access Control for Remote Assets" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-devices ;
    ciso:belongsToControl cis:13 ;
    ciso:description "Manage access control for assets remotely connecting to enterprise resources. Determine amount of access to enterprise resources based on: up-to-date anti-malware software installed, configuration compliance with the enterprise’s secure configuration process, and ensuring the operating system and applications are up-to-date." ;
    ciso:identifier "13.5" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:13.6 a ciso:Safeguard ;
    rdfs:label "Collect Network Traffic Flow Logs" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-network ;
    ciso:belongsToControl cis:13 ;
    ciso:description "Collect network traffic flow logs and/or network traffic to review and alert upon from network devices." ;
    ciso:identifier "13.6" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-detect .

cis:13.7 a ciso:Safeguard ;
    rdfs:label "Deploy a Host-Based Intrusion Prevention Solution" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-devices ;
    ciso:belongsToControl cis:13 ;
    ciso:description "Deploy a host-based intrusion prevention solution on enterprise assets, where appropriate and/or supported. Example implementations include use of an Endpoint Detection and Response (EDR) client or host-based IPS agent." ;
    ciso:identifier "13.7" ;
    ciso:implementationGroup cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:13.8 a ciso:Safeguard ;
    rdfs:label "Deploy a Network Intrusion Prevention Solution" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-network ;
    ciso:belongsToControl cis:13 ;
    ciso:description "Deploy a network intrusion prevention solution, where appropriate. Example implementations include the use of a Network Intrusion Prevention System (NIPS) or equivalent CSP service." ;
    ciso:identifier "13.8" ;
    ciso:implementationGroup cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:13.9 a ciso:Safeguard ;
    rdfs:label "Deploy Port-Level Access Control" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-network ;
    ciso:belongsToControl cis:13 ;
    ciso:description "Deploy port-level access control. Port-level access control utilizes 802.1x, or similar network access control protocols, such as certificates, and may incorporate user and/or device authentication." ;
    ciso:identifier "13.9" ;
    ciso:implementationGroup cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:14.1 a ciso:Safeguard ;
    rdfs:label "Establish and Maintain a Security Awareness Program" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-documentation ;
    ciso:belongsToControl cis:14 ;
    ciso:description "Establish and maintain a security awareness program. The purpose of a security awareness program is to educate the enterprise’s workforce on how to interact with enterprise assets and data in a secure manner. Conduct training at hire and, at a minimum, annually. Review and update content annually, or when significant enterprise changes occur that could impact this Safeguard." ;
    ciso:identifier "14.1" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-govern .

cis:14.2 a ciso:Safeguard ;
    rdfs:label "Train Workforce Members to Recognize Social Engineering Attacks" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-users ;
    ciso:belongsToControl cis:14 ;
    ciso:description "Train workforce members to recognize social engineering attacks, such as phishing, business email compromise (BEC), pretexting, and tailgating." ;
    ciso:identifier "14.2" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:14.3 a ciso:Safeguard ;
    rdfs:label "Train Workforce Members on Authentication Best Practices" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-users ;
    ciso:belongsToControl cis:14 ;
    ciso:description "Train workforce members on authentication best practices. Example topics include MFA, password composition, and credential management." ;
    ciso:identifier "14.3" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:14.4 a ciso:Safeguard ;
    rdfs:label "Train Workforce on Data Handling Best Practices" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-users ;
    ciso:belongsToControl cis:14 ;
    ciso:description "Train workforce members on how to identify and properly store, transfer, archive, and destroy sensitive data. This also includes training workforce members on clear screen and desk best practices, such as locking their screen when they step away from their enterprise asset, erasing physical and virtual whiteboards at the end of meetings, and storing data and assets securely." ;
    ciso:identifier "14.4" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:14.5 a ciso:Safeguard ;
    rdfs:label "Train Workforce Members on Causes of Unintentional Data Exposure" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-users ;
    ciso:belongsToControl cis:14 ;
    ciso:description "Train workforce members to be aware of causes for unintentional data exposure. Example topics include mis-delivery of sensitive data, losing a portable end-user device, or publishing data to unintended audiences." ;
    ciso:identifier "14.5" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:14.6 a ciso:Safeguard ;
    rdfs:label "Train Workforce Members on Recognizing and Reporting" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-users ;
    ciso:belongsToControl cis:14 ;
    ciso:description "Train workforce members to be able to recognize a potential incident and be able to report such an incident." ;
    ciso:identifier "14.6" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:14.7 a ciso:Safeguard ;
    rdfs:label "Train Workforce on How to Identify and Report if Their Enterprise" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-users ;
    ciso:belongsToControl cis:14 ;
    ciso:description "Train workforce to understand how to verify and report out-of-date software patches or any failures in automated processes and tools. Part of this training should include notifying IT personnel of any failures in automated processes and tools." ;
    ciso:identifier "14.7" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:14.8 a ciso:Safeguard ;
    rdfs:label "Train Workforce on the Dangers of Connecting to and Transmitting" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-users ;
    ciso:belongsToControl cis:14 ;
    ciso:description "Train workforce members on the dangers of connecting to, and transmitting data over, insecure networks for enterprise activities. If the enterprise has remote workers, training must include guidance to ensure that all users securely configure their home network infrastructure." ;
    ciso:identifier "14.8" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:14.9 a ciso:Safeguard ;
    rdfs:label "Conduct Role-Specific Security Awareness and Skills Training" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-users ;
    ciso:belongsToControl cis:14 ;
    ciso:description "Conduct role-specific security awareness and skills training. Example implementations include secure system administration courses for IT professionals, OWASP® Top 10 vulnerability awareness and prevention training for web application developers, and advanced social engineering awareness training for high-profile roles." ;
    ciso:identifier "14.9" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:15.1 a ciso:Safeguard ;
    rdfs:label "Establish and Maintain an Inventory of Service Providers" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-users ;
    ciso:belongsToControl cis:15 ;
    ciso:description "Establish and maintain an inventory of service providers. The inventory is to list all known service providers, include classification(s), and designate an enterprise contact for each service provider. Review and update the inventory annually, or when significant enterprise changes occur that could impact this Safeguard." ;
    ciso:identifier "15.1" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-identify .

cis:15.2 a ciso:Safeguard ;
    rdfs:label "Establish and Maintain a Service Provider Management Policy" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-documentation ;
    ciso:belongsToControl cis:15 ;
    ciso:description "Establish and maintain a service provider management policy. Ensure the policy addresses the classification, inventory, assessment, monitoring, and decommissioning of service providers. Review and update the policy annually, or when significant enterprise changes occur that could impact this Safeguard." ;
    ciso:identifier "15.2" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-govern .

cis:15.3 a ciso:Safeguard ;
    rdfs:label "Classify Service Providers" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-users ;
    ciso:belongsToControl cis:15 ;
    ciso:description "Classify service providers. Classification consideration may include one or more characteristics, such as data sensitivity, data volume, availability requirements, applicable regulations, inherent risk, and mitigated risk. Update and review classifications annually, or when significant enterprise changes occur that could impact this Safeguard." ;
    ciso:identifier "15.3" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-govern .

cis:15.4 a ciso:Safeguard ;
    rdfs:label "Ensure Service Provider Contracts Include Security Requirements" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-documentation ;
    ciso:belongsToControl cis:15 ;
    ciso:description "Ensure service provider contracts include security requirements. Example requirements may include minimum security program requirements, security incident and/or data breach notification and response, data encryption requirements, and data disposal commitments. These security requirements must be consistent with the enterprise’s service provider management policy. Review service provider contracts annually to ensure contracts are not missing security requirements." ;
    ciso:identifier "15.4" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-govern .

cis:15.5 a ciso:Safeguard ;
    rdfs:label "Assess Service Providers" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-users ;
    ciso:belongsToControl cis:15 ;
    ciso:description "Assess service providers consistent with the enterprise’s service provider management policy. Assessment scope may vary based on classification(s), and may include review of standardized assessment reports, such as Service Organization Control 2 (SOC 2) and Payment Card Industry (PCI) Attestation of Compliance (AoC), customized questionnaires, or other appropriately rigorous processes. Reassess service providers annually, at a minimum, or with new and renewed contracts." ;
    ciso:identifier "15.5" ;
    ciso:implementationGroup cis:ig3 ;
    ciso:securityFunction cis:security-function-govern .

cis:15.6 a ciso:Safeguard ;
    rdfs:label "Monitor Service Providers" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-data ;
    ciso:belongsToControl cis:15 ;
    ciso:description "Monitor service providers consistent with the enterprise’s service provider management policy. Monitoring may include periodic reassessment of service provider compliance, monitoring service provider release notes, and dark web monitoring." ;
    ciso:identifier "15.6" ;
    ciso:implementationGroup cis:ig3 ;
    ciso:securityFunction cis:security-function-govern .

cis:15.7 a ciso:Safeguard ;
    rdfs:label "Securely Decommission Service Providers" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-data ;
    ciso:belongsToControl cis:15 ;
    ciso:description "Securely decommission service providers. Example considerations include user and service account deactivation, termination of data flows, and secure disposal of enterprise data within service provider systems." ;
    ciso:identifier "15.7" ;
    ciso:implementationGroup cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:16.1 a ciso:Safeguard ;
    rdfs:label "Establish and Maintain a Secure Application Development Process" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-documentation ;
    ciso:belongsToControl cis:16 ;
    ciso:description "Establish and maintain a secure application development process. In the process, address such items as: secure application design standards, secure coding practices, developer training, vulnerability management, security of third-party code, and application security testing procedures. Review and update documentation annually, or when significant enterprise changes occur that could impact this Safeguard." ;
    ciso:identifier "16.1" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-govern .

cis:16.10 a ciso:Safeguard ;
    rdfs:label "Apply Secure Design Principles in Application Architectures" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-software ;
    ciso:belongsToControl cis:16 ;
    ciso:description "Apply secure design principles in application architectures. Secure design principles include the concept of least privilege and enforcing mediation to validate every operation that the user makes, promoting the concept of “never trust user input.” Examples include ensuring that explicit error checking is performed and documented for all input, including for size, data type, and acceptable ranges or formats. Secure design also means minimizing the application infrastructure attack surface, such as turning off unprotected ports and services, removing unnecessary programs and files, and renaming or removing default accounts." ;
    ciso:identifier "16.10" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:16.11 a ciso:Safeguard ;
    rdfs:label "Leverage Vetted Modules or Services for Application" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-software ;
    ciso:belongsToControl cis:16 ;
    ciso:description "Leverage vetted modules or services for application security components, such as identity management, encryption, auditing, and logging. Using platform features in critical security functions will reduce developers’ workload and minimize the likelihood of design or implementation errors. Modern operating systems provide effective mechanisms for identification, authentication, and authorization and make those mechanisms available to applications. Use only standardized, currently accepted, and extensively reviewed encryption algorithms. Operating systems also provide mechanisms to create and maintain secure audit logs." ;
    ciso:identifier "16.11" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:16.12 a ciso:Safeguard ;
    rdfs:label "Implement Code-Level Security Checks" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-software ;
    ciso:belongsToControl cis:16 ;
    ciso:description "Apply static and dynamic analysis tools within the application life cycle to verify that secure coding practices are being followed." ;
    ciso:identifier "16.12" ;
    ciso:implementationGroup cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:16.13 a ciso:Safeguard ;
    rdfs:label "Conduct Application Penetration Testing" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-software ;
    ciso:belongsToControl cis:16 ;
    ciso:description "Conduct application penetration testing. For critical applications, authenticated penetration testing is better suited to finding business logic vulnerabilities than code scanning and automated security testing. Penetration testing relies on the skill of the tester to manually manipulate an application as an authenticated and unauthenticated user." ;
    ciso:identifier "16.13" ;
    ciso:implementationGroup cis:ig3 ;
    ciso:securityFunction cis:security-function-detect .

cis:16.14 a ciso:Safeguard ;
    rdfs:label "Conduct Threat Modeling" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-software ;
    ciso:belongsToControl cis:16 ;
    ciso:description "Conduct threat modeling. Threat modeling is the process of identifying and addressing application security design flaws within a design, before code is created. It is conducted through specially trained individuals who evaluate the application design and gauge security risks for each entry point and access level. The goal is to map out the application, architecture, and infrastructure in a structured way to understand its weaknesses." ;
    ciso:identifier "16.14" ;
    ciso:implementationGroup cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:16.2 a ciso:Safeguard ;
    rdfs:label "Establish and Maintain a Process to Accept and Address Software" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-documentation ;
    ciso:belongsToControl cis:16 ;
    ciso:description "Establish and maintain a process to accept and address reports of software vulnerabilities, including providing a means for external entities to report. The process is to include such items as: a vulnerability handling policy that identifies reporting process, responsible party for handling vulnerability reports, and a process for intake, assignment, remediation, and remediation testing. As part of the process, use a vulnerability tracking system that includes severity ratings and metrics for measuring timing for identification, analysis, and remediation of vulnerabilities. Review and update documentation annually, or when significant enterprise changes occur that could impact this Safeguard. Third-party application developers need to consider this an externally-facing policy that helps to set expectations for outside stakeholders." ;
    ciso:identifier "16.2" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-govern .

cis:16.3 a ciso:Safeguard ;
    rdfs:label "Perform Root Cause Analysis on Security Vulnerabilities" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-software ;
    ciso:belongsToControl cis:16 ;
    ciso:description "Perform root cause analysis on security vulnerabilities. When reviewing vulnerabilities, root cause analysis is the task of evaluating underlying issues that create vulnerabilities in code, and allows development teams to move beyond just fixing individual vulnerabilities as they arise." ;
    ciso:identifier "16.3" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-detect .

cis:16.4 a ciso:Safeguard ;
    rdfs:label "Establish and Manage an Inventory of Third-Party" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-software ;
    ciso:belongsToControl cis:16 ;
    ciso:description "Establish and manage an updated inventory of third-party components used in development, often referred to as a “bill of materials,” as well as components slated for future use. This inventory is to include any risks that each third-party component could pose. Evaluate the list at least monthly to identify any changes or updates to these components, and validate that the component is still supported." ;
    ciso:identifier "16.4" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-identify .

cis:16.5 a ciso:Safeguard ;
    rdfs:label "Use Up-to-Date and Trusted Third-Party Software Components" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-software ;
    ciso:belongsToControl cis:16 ;
    ciso:description "Use up-to-date and trusted third-party software components. When possible, choose established and proven frameworks and libraries that provide adequate security. Acquire these components from trusted sources or evaluate the software for vulnerabilities before use." ;
    ciso:identifier "16.5" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:16.6 a ciso:Safeguard ;
    rdfs:label "Establish and Maintain a Severity Rating System and Process for" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-documentation ;
    ciso:belongsToControl cis:16 ;
    ciso:description "Establish and maintain a severity rating system and process for application vulnerabilities that facilitates prioritizing the order in which discovered vulnerabilities are fixed. This process includes setting a minimum level of security acceptability for releasing code or applications. Severity ratings bring a systematic way of triaging vulnerabilities that improves risk management and helps ensure the most severe bugs are fixed first. Review and update the system and process annually." ;
    ciso:identifier "16.6" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-govern .

cis:16.7 a ciso:Safeguard ;
    rdfs:label "Use Standard Hardening Configuration Templates for Application" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-software ;
    ciso:belongsToControl cis:16 ;
    ciso:description "Use standard, industry-recommended hardening configuration templates for application infrastructure components. This includes underlying servers, databases, and web servers, and applies to cloud containers, Platform as a Service (PaaS) components, and SaaS components. Do not allow in-house developed software to weaken configuration hardening." ;
    ciso:identifier "16.7" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:16.8 a ciso:Safeguard ;
    rdfs:label "Separate Production and Non-Production Systems" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-network ;
    ciso:belongsToControl cis:16 ;
    ciso:description "Maintain separate environments for production and non-production systems." ;
    ciso:identifier "16.8" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:16.9 a ciso:Safeguard ;
    rdfs:label "Train Developers in Application Security Concepts and Secure Coding" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-users ;
    ciso:belongsToControl cis:16 ;
    ciso:description "Ensure that all software development personnel receive training in writing secure code for their specific development environment and responsibilities. Training can include general security principles and application security standard practices. Conduct training at least annually and design in a way to promote security within the development team, and build a culture of security among the developers." ;
    ciso:identifier "16.9" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:17.1 a ciso:Safeguard ;
    rdfs:label "Designate Personnel to Manage Incident Handling" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-users ;
    ciso:belongsToControl cis:17 ;
    ciso:description "Designate one key person, and at least one backup, who will manage the enterprise’s incident handling process. Management personnel are responsible for the coordination and documentation of incident response and recovery efforts and can consist of employees internal to the enterprise, service providers, or a hybrid approach. If using a service provider, designate at least one person internal to the enterprise to oversee any third-party work. Review annually, or when significant enterprise changes occur that could impact this Safeguard." ;
    ciso:identifier "17.1" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-respond .

cis:17.2 a ciso:Safeguard ;
    rdfs:label "Establish and Maintain Contact Information for Reporting" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-documentation ;
    ciso:belongsToControl cis:17 ;
    ciso:description "Establish and maintain contact information for parties that need to be informed of security incidents. Contacts may include internal staff, service providers, law enforcement, cyber insurance providers, relevant government agencies, Information Sharing and Analysis Center (ISAC) partners, or other stakeholders. Verify contacts annually to ensure that information is up-to-date." ;
    ciso:identifier "17.2" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-govern .

cis:17.3 a ciso:Safeguard ;
    rdfs:label "Establish and Maintain an Enterprise Process for Reporting Incidents" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-documentation ;
    ciso:belongsToControl cis:17 ;
    ciso:description "Establish and maintain an documented enterprise process for the workforce to report security incidents. The process includes reporting timeframe, personnel to report to, mechanism for reporting, and the minimum information to be reported. Ensure the process is publicly available to all of the workforce. Review annually, or when significant enterprise changes occur that could impact this Safeguard." ;
    ciso:identifier "17.3" ;
    ciso:implementationGroup cis:ig1,
        cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-govern .

cis:17.4 a ciso:Safeguard ;
    rdfs:label "Establish and Maintain an Incident Response Process" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-documentation ;
    ciso:belongsToControl cis:17 ;
    ciso:description "Establish and maintain a documented incident response process that addresses roles and responsibilities, compliance requirements, and a communication plan. Review annually, or when significant enterprise changes occur that could impact this Safeguard." ;
    ciso:identifier "17.4" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-govern .

cis:17.5 a ciso:Safeguard ;
    rdfs:label "Assign Key Roles and Responsibilities" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-users ;
    ciso:belongsToControl cis:17 ;
    ciso:description "Assign key roles and responsibilities for incident response, including staff from legal, IT, information security, facilities, public relations, human resources, incident responders, analysts, and relevant third parties. Review annually, or when significant enterprise changes occur that could impact this Safeguard." ;
    ciso:identifier "17.5" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-respond .

cis:17.6 a ciso:Safeguard ;
    rdfs:label "Define Mechanisms for Communicating During Incident Response" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-users ;
    ciso:belongsToControl cis:17 ;
    ciso:description "Determine which primary and secondary mechanisms will be used to communicate and report during a security incident. Mechanisms can include phone calls, emails, secure chat, or notification letters. Keep in mind that certain mechanisms, such as emails, can be affected during a security incident. Review annually, or when significant enterprise changes occur that could impact this Safeguard." ;
    ciso:identifier "17.6" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-respond .

cis:17.7 a ciso:Safeguard ;
    rdfs:label "Conduct Routine Incident Response Exercises" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-users ;
    ciso:belongsToControl cis:17 ;
    ciso:description "Plan and conduct routine incident response exercises and scenarios for key personnel involved in the incident response process to prepare for responding to real-world incidents. Exercises need to test communication channels, decision making, and workflows. Conduct testing on an annual basis, at a minimum." ;
    ciso:identifier "17.7" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-recover .

cis:17.8 a ciso:Safeguard ;
    rdfs:label "Conduct Post-Incident Reviews" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-users ;
    ciso:belongsToControl cis:17 ;
    ciso:description "Conduct post-incident reviews. Post-incident reviews help prevent incident recurrence through identifying lessons learned and follow-up action." ;
    ciso:identifier "17.8" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-recover .

cis:17.9 a ciso:Safeguard ;
    rdfs:label "Establish and Maintain Security Incident Thresholds" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-documentation ;
    ciso:belongsToControl cis:17 ;
    ciso:description "Establish and maintain security incident thresholds, including, at a minimum, differentiating between an incident and an event. Examples can include: abnormal activity, security vulnerability, security weakness, data breach, privacy incident, etc. Review annually, or when significant enterprise changes occur that could impact this Safeguard." ;
    ciso:identifier "17.9" ;
    ciso:implementationGroup cis:ig3 ;
    ciso:securityFunction cis:security-function-recover .

cis:18.1 a ciso:Safeguard ;
    rdfs:label "Establish and Maintain a Penetration Testing Program" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-documentation ;
    ciso:belongsToControl cis:18 ;
    ciso:description "Establish and maintain a penetration testing program appropriate to the size, complexity, industry, and maturity of the enterprise. Penetration testing program characteristics include scope, such as network, web application, Application Programming Interface (API), hosted services, and physical premise controls; frequency; limitations, such as acceptable hours, and excluded attack types; point of contact information; remediation, such as how findings will be routed internally; and retrospective requirements." ;
    ciso:identifier "18.1" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-govern .

cis:18.2 a ciso:Safeguard ;
    rdfs:label "Perform Periodic External Penetration Tests" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-network ;
    ciso:belongsToControl cis:18 ;
    ciso:description "Perform periodic external penetration tests based on program requirements, no less than annually. External penetration testing must include enterprise and environmental reconnaissance to detect exploitable information. Penetration testing requires specialized skills and experience and must be conducted through a qualified party. The testing may be clear box or opaque box." ;
    ciso:identifier "18.2" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-detect .

cis:18.3 a ciso:Safeguard ;
    rdfs:label "Remediate Penetration Test Findings" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-network ;
    ciso:belongsToControl cis:18 ;
    ciso:description "Remediate penetration test findings based on the enterprise’s documented vulnerability remediation process. This should include determining a timeline and level of effort based on the impact and prioritization of each identified finding." ;
    ciso:identifier "18.3" ;
    ciso:implementationGroup cis:ig2,
        cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:18.4 a ciso:Safeguard ;
    rdfs:label "Validate Security Measures" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-network ;
    ciso:belongsToControl cis:18 ;
    ciso:description "Validate security measures after each penetration test. If deemed necessary, modify rulesets and capabilities to detect the techniques used during testing." ;
    ciso:identifier "18.4" ;
    ciso:implementationGroup cis:ig3 ;
    ciso:securityFunction cis:security-function-protect .

cis:18.5 a ciso:Safeguard ;
    rdfs:label "Perform Periodic Internal Penetration Tests" ;
    dcterms:isPartOf cis:framework ;
    ciso:assetType cis:asset-type-network ;
    ciso:belongsToControl cis:18 ;
    ciso:description "Perform periodic internal penetration tests based on program requirements, no less than annually. The testing may be clear box or opaque box. Appendix Acronyms and Abbreviations AAA Authentication, Authorization, and Auditing DNS Domain Name System ACL Access Control List DPI Deep Packet Inspection AD Active Directory EDR Endpoint Detection and Response AoC Attestation of Compliance EOL End of Life API Application Programming Interface FFIEC Federal Financial Institutions Examination Council BEC Business Email Compromise FIRST Forum of Incident Response and C2 Command and Control Security Teams, Inc. CCE Common Configuration Enumeration FISMA Federal Information Security Modernization Act CDM Community Defense Model GRC Governance Risk and Compliance CIA Confidentiality, Integrity, and Availability HECVAT Higher Education Community Vendor CIS Center for Internet Security Assessment Toolkit CIS-CAT CIS Configuration Assessment Tool HIPAA Health Insurance Portability and Accountability Act COTS Commercial off-the-Shelf HTTP Hypertext Transfer Protocol CPE Common Platform Enumeration HTTPS Hypertext Transfer Protocol Secure CREST Council of Registered Security Testers IaaS Infrastructure as a Service CSA Cloud Security Alliance IaC Infrastructure as Code CSP Cloud Service Provider IAM Identity and Access Management CVE Common Vulnerabilities and Exposures IDS Intrusion Detection System CVSS Common Vulnerability Scoring System IG Implementation Group DBIR Data Breach Investigations Report IOCs Indicators of Compromise DEP Data Execution Prevention IoT Internet of Things DG Development Group IP Internet Protocol DHCP Dynamic Host Configuration Protocol IPS Intrusion Prevention System DKIM DomainKeys Identified Mail ISAC Information Sharing and Analysis DLP Data Loss Prevention Center DMARC Domain-based Message Authentication, ISO International Organization for Reporting, and Conformance Standardization DMS Database Management System IT Information T