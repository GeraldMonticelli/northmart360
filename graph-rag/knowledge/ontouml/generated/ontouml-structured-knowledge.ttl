<https://w3id.org/ontouml/knowledge#refactoring/4-cba19d6648bded90> a ok:RefactoringPlan ;
    rdfs:label "[New] Specialize:" ;
    skos:definition "[New] Specialize: the logical implication of this solution is the same as enforcing subsetting. Nonetheless, it should only be selected if association B is a particular type of A and not only if the logical constraint is required. \\*Assuming that the occurrence is the structural variation number 1." ;
    prov:wasDerivedFrom <urn:ontouml:source:anti-patterns/anti-patterns/RelSpec/index.rst> ;
    ok:order 4 ;
