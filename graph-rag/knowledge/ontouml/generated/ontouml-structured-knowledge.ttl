<https://w3id.org/ontouml/knowledge#refactoring/4-7efde2b59e072015> a ok:RefactoringPlan ;
    rdfs:label "[OCL] Set Forbidden Composition:" ;
    skos:definition "[OCL] Set Forbidden Composition: add an OCL invariant to enforce that type B has a forbidden composition to type A: [figure: context BSource ] inv: self.bTarget->asSet()->forAll( y [figure: ] ASource.allInstances()->forAll( z [figure: ] not(z.aTarget->asSet()->contains(y) and | z.aTarget->asSet()->contains(self)))" ;
