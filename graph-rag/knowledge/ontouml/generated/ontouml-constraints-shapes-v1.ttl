?other ontouml:stereotype ?forbidden .
  VALUES ?forbidden { <https://w3id.org/ontouml#phase> <https://w3id.org/ontouml#phaseMixin> <https://w3id.org/ontouml#role> <https://w3id.org/ontouml#roleMixin> }
}""" ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes ok:OntoUMLPrefixes ;
            sh:select """SELECT ?this
WHERE {
  ?this a ontouml:Class ;
        ontouml:stereotype <https://w3id.org/ontouml#category> .
}""" ] ;
    ok:implementsConstraint <https://w3id.org/ontouml/knowledge#constraint/category-c3> .

