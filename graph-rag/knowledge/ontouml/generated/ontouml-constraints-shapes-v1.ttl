<https://w3id.org/ontouml/knowledge#shape/category-c2> a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "category-c2: forbidden subtype stereotype for category." ;
            sh:prefixes ok:OntoUMLPrefixes ;
            sh:select """SELECT $this ?other ?forbidden
WHERE {
  $this (^ontouml:general/ontouml:specific)+ ?other .
?other ontouml:stereotype ?forbidden .
  VALUES ?forbidden { <https://w3id.org/ontouml#collective> <https://w3id.org/ontouml#kind> <https://w3id.org/ontouml#mode> <https://w3id.org/ontouml#phase> <https://w3id.org/ontouml#quality> <https://w3id.org/ontouml#quantity> <https://w3id.org/ontouml#relator> <https://w3id.org/ontouml#role> <https://w3id.org/ontouml#subkind> }
}""" ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes ok:OntoUMLPrefixes ;
            sh:select """SELECT ?this
WHERE {
  ?this a ontouml:Class ;
        ontouml:stereotype <https://w3id.org/ontouml#category> .
}""" ] ;
    ok:implementsConstraint <https://w3id.org/ontouml/knowledge#constraint/category-c2> .

