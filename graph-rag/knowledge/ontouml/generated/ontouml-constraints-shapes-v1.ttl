<https://w3id.org/ontouml/knowledge#shape/phase-c1> a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "phase-c1: exactly 1 identity-provider ancestor is required." ;
            sh:prefixes ok:OntoUMLPrefixes ;
            sh:select """SELECT $this
WHERE {
  {
    SELECT $this (COUNT(DISTINCT ?provider) AS ?count)
    WHERE {
      $this (^ontouml:specific/ontouml:general)+ ?provider .
      ?provider ontouml:stereotype ?providerType .
      VALUES ?providerType { <https://w3id.org/ontouml#kind> <https://w3id.org/ontouml#collective> <https://w3id.org/ontouml#quantity> <https://w3id.org/ontouml#relator> <https://w3id.org/ontouml#mode> }
    }
    GROUP BY $this
  }
  FILTER (?count != 1)
}""" ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes ok:OntoUMLPrefixes ;
            sh:select """SELECT ?this WHERE {
  ?this a ontouml:Class ; ontouml:stereotype <https://w3id.org/ontouml#phase> .
}""" ] ;
    ok:implementsConstraint <https://w3id.org/ontouml/knowledge#constraint/phase-c1> .

<https://w3id.org/ontouml/knowledge#shape/phase-c3> a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "phase-c3: forbidden supertype stereotype for phase." ;
            sh:prefixes ok:OntoUMLPrefixes ;
            sh:select """SELECT $this ?other ?forbidden
WHERE {
  ?gen ontouml:specific $this ;
      ontouml:general ?other .
?other ontouml:stereotype ?forbidden .
  VALUES ?forbidden { <https://w3id.org/ontouml#role> <https://w3id.org/ontouml#roleMixin> }
}""" ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes ok:OntoUMLPrefixes ;
            sh:select """SELECT ?this
WHERE {
