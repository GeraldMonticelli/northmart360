<https://w3id.org/ontouml/knowledge#constraint/memberof-c1> a ok:Constraint ;
    rdfs:label "memberOf C1" ;
    skos:definition "This relation can only represent essential parthood if the object representing the whole is extensional (i.e. provided that adding or removing of any member changes the identity of the collective). In this case, all parthood relations in which the whole is extensional are constrained as {essential} parthood relations." ;
    prov:wasDerivedFrom <urn:ontouml:source:relationships/aggregations/memberOf/constraints.rst> ;
    ok:appliesTo ontouml:memberOf ;
    ok:code "C1" ;
    ok:semanticStatus ok:SourceOnly ;
    ok:sourceText "This relation can only represent **essential** parthood if the object representing the whole is **extensional** (i.e. provided that adding or removing of any member changes the identity of the collective). In this case, all parthood relations in which the whole is extensional are constrained as **{essential}** parthood relations." .

<https://w3id.org/ontouml/knowledge#constraint/memberof-c2> a ok:Constraint ;
    rdfs:label "memberOf C2" ;
    skos:definition "The classifier connected to the whole end must be a «collective». The classifier connected to the part end can be either a «collective» or functional complex." ;
    prov:wasDerivedFrom <urn:ontouml:source:relationships/aggregations/memberOf/constraints.rst> ;
    ok:appliesTo ontouml:memberOf ;
    ok:code "C2" ;
    ok:modality ok:Required ;
    ok:references ontouml:collective ;
    ok:semanticStatus ok:DerivedFromText ;
    ok:sourceText "The classifier connected to the whole end must be a «:ref:`collective`». The classifier connected to the part end can be either a «:ref:`collective`» or **functional complex**." .

