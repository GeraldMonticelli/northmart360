    ok:semanticStatus ok:DerivedFromText ;
    ok:sourceText "A «:ref:`phase`» must always be part of a partition (a generalization set disjoint and complete). Modeling a «:ref:`phase`» as in example below is forbidden:" .

<https://w3id.org/ontouml/knowledge#constraint/phase-c3> a ok:Constraint ;
    rdfs:label "Phase C3" ;
    skos:definition "A «phase» cannot be a direct subtype of a «role» or «rolemixin»." ;
    prov:wasDerivedFrom <urn:ontouml:source:classes/sortals/phase/constraints.rst> ;
    ok:appliesTo ontouml:phase ;
