    ok:relation ok:Subtype ;
    ok:semanticStatus ok:DerivedFromText ;
    ok:sourceText "A «:ref:`phase`» cannot be a direct subtype of a «:ref:`role`» or «:ref:`rolemixin`»." .

<https://w3id.org/ontouml/knowledge#constraint/phase-c4> a ok:Constraint ;
    rdfs:label "Phase C4" ;
    skos:definition "A «phase» cannot be a super-type of a rigid type («kind», «collective», «quantity», «relator», «mode», «quantity», «subkind», «category»)." ;
