<https://w3id.org/ontouml/knowledge#antipattern/relover/refactoring-1> a ok:RefactoringPlan ;
    rdfs:label "[OCL] Exclusiveness" ;
    skos:definition """[OCL] Exclusiveness \\: choose this option to forbid the same individual to play multiple roles w.r.t the same relator instance. Create an OCL invariant according to the following template:
 | context Relator
 | inv: self.over1.oclAsType(Supertype)->asSet()->excludesAll(
 | self.over2.oclAsType(Agent)->asSet() and
 | self.over1.oclAsType(Supertype)->asSet()->excludesAll(
 | self.over3.oclAsType(Agent)->asSet() and
 | self.over2.oclAsType(Supertype)->asSet()->excludesAll(
 | self.over3.oclAsType(Agent)->asSet())*""" ;
    prov:wasDerivedFrom <urn:ontouml:source:anti-patterns/RelOver/index.rst> ;
    ok:order 1 ;
    ok:sourceText """**[OCL] Exclusiveness** \\*: choose this option to forbid the same individual to play multiple roles w.r.t the same relator instance. Create an OCL invariant according to the following template:

		| *context Relator*
		| *inv: self.over1.oclAsType(Supertype)->asSet()->excludesAll(*
		| *self.over2.oclAsType(Agent)->asSet() and*
		| *self.over1.oclAsType(Supertype)->asSet()->excludesAll(*
		| *self.over3.oclAsType(Agent)->asSet() and*
		| *self.over2.oclAsType(Supertype)->asSet()->excludesAll(*
		| *self.over3.oclAsType(Agent)->asSet())*""" .

