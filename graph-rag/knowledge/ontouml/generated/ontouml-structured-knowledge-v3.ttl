<https://w3id.org/ontouml/knowledge#antipattern/binover/condition-2> a ok:DetectionCondition ;
    rdfs:label "BinOver condition 2" ;
    skos:definition "<Source> is a direct or indirect subtype of <Target>" ;
    prov:wasDerivedFrom <urn:ontouml:source:anti-patterns/BinOver/index.rst> ;
    ok:order 2 ;
    ok:sourceText "*<Source>* is a direct or indirect subtype of *<Target>*" .

<https://w3id.org/ontouml/knowledge#antipattern/binover/condition-3> a ok:DetectionCondition ;
    rdfs:label "BinOver condition 3" ;
    skos:definition "<Target> is a direct or indirect subtype of <Source>" ;
    prov:wasDerivedFrom <urn:ontouml:source:anti-patterns/BinOver/index.rst> ;
    ok:order 3 ;
    ok:sourceText "*<Target>* is a direct or indirect subtype of *<Source>*" .

<https://w3id.org/ontouml/knowledge#antipattern/binover/condition-4> a ok:DetectionCondition ;
    rdfs:label "BinOver condition 4" ;
    skos:definition "<Source> and <Target> are sortals («subkind», «role» or «phase») that share a common identity provider («kind», «quantity», «collective») and there is no generalization set which makes them explicitly disjoint" ;
    prov:wasDerivedFrom <urn:ontouml:source:anti-patterns/BinOver/index.rst> ;
    ok:order 4 ;
    ok:references ontouml:collective,
        ontouml:kind,
        ontouml:phase,
        ontouml:quantity,
        ontouml:role,
        ontouml:subkind ;
    ok:sourceText "*<Source>* and *<Target>* are sortals («:ref:`subkind`», «:ref:`role`» or «:ref:`phase`») that share a common identity provider («:ref:`kind`», «:ref:`quantity`», «:ref:`collective`») and there is no generalization set which makes them explicitly disjoint" .

<https://w3id.org/ontouml/knowledge#antipattern/binover/condition-5> a ok:DetectionCondition ;
    rdfs:label "BinOver condition 5" ;
    skos:definition "<Source> and <Target> are relators that share a common super-type and there is no generalization set which makes them explicitly disjoint" ;
    prov:wasDerivedFrom <urn:ontouml:source:anti-patterns/BinOver/index.rst> ;
    ok:order 5 ;
    ok:sourceText "*<Source>* and *<Target>* are relators that share a common super-type and there is no generalization set which makes them explicitly disjoint" .

<https://w3id.org/ontouml/knowledge#antipattern/binover/condition-6> a ok:DetectionCondition ;
    rdfs:label "BinOver condition 6" ;
    skos:definition "<Source> and <Target> are modes that share a common super-type and there is no generalization set which makes them explicitly disjoint;" ;
    prov:wasDerivedFrom <urn:ontouml:source:anti-patterns/BinOver/index.rst> ;
    ok:order 6 ;
    ok:sourceText "*<Source>* and *<Target>* are modes that share a common super-type and there is no generalization set which makes them explicitly disjoint;" .

<https://w3id.org/ontouml/knowledge#antipattern/binover/condition-7> a ok:DetectionCondition ;
    rdfs:label "BinOver condition 7" ;
    skos:definition "<Source> and <Target> are mixins («category», «mixin» or «rolemixin») that directly or indirectly generalize at least one common sortal («kind», «quantity», «collective», «subkind», «role», «phase»)" ;
    prov:wasDerivedFrom <urn:ontouml:source:anti-patterns/BinOver/index.rst> ;
    ok:order 7 ;
    ok:references ontouml:category,
        ontouml:collective,
        ontouml:kind,
        ontouml:mixin,
        ontouml:phase,
        ontouml:quantity,
        ontouml:role,
        ontouml:roleMixin,
        ontouml:subkind ;
    ok:sourceText "*<Source>* and *<Target>* are mixins («:ref:`category`», «:ref:`mixin`» or «:ref:`rolemixin`») that directly or indirectly generalize at least one common sortal («:ref:`kind`», «:ref:`quantity`», «:ref:`collective`», «:ref:`subkind`», «:ref:`role`», «:ref:`phase`»)" .

<https://w3id.org/ontouml/knowledge#antipattern/binover/condition-8> a ok:DetectionCondition ;
    rdfs:label "BinOver condition 8" ;
    skos:definition "<Source> and <Target> are mixins («category», «mixin» or «rolemixin») that share a common mixin super-type and none of their subtypes are sortals" ;
    prov:wasDerivedFrom <urn:ontouml:source:anti-patterns/BinOver/index.rst> ;
    ok:order 8 ;
    ok:references ontouml:category,
        ontouml:mixin,
        ontouml:roleMixin ;
