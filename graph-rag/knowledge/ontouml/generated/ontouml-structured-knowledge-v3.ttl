<https://w3id.org/ontouml/knowledge#constraint/mixin-c2> a ok:Constraint ;
    rdfs:label "Mixin C2" ;
    skos:definition "A «mixin» is a semi-rigid construct and because of that, it cannot have as ancestor either a rigid (other than «category») or an anti-rigid type. Therefore, only :ref:`mixins <mixin>>` and :ref:`categories <category>>` can be ancestor of other mixins." ;
    prov:wasDerivedFrom <urn:ontouml:source:classes/nonsortals/mixin/constraints.rst> ;
    ok:appliesTo ontouml:mixin ;
    ok:code "C2" ;
    ok:constraintType ok:RigidityConstraint ;
    ok:forbiddenTypes ( ontouml:category ) ;
    ok:hasFigure <https://w3id.org/ontouml/knowledge#figure/mixin-forbidden-1-a2da00dceb1c1127> ;
    ok:modality ok:Forbidden ;
    ok:pathScope ok:DirectOrIndirect ;
    ok:references ontouml:category,
        ontouml:mixin,
        <https://w3id.org/ontouml/knowledge#reference/rigidity> ;
    ok:relation ok:Supertype ;
    ok:semanticStatus ok:DerivedFromText ;
    ok:sourceText "A «:ref:`mixin`» is a :ref:`semi-rigid <rigidity>` construct and because of that, it cannot have as ancestor either a :ref:`rigid <rigidity>` (other than «:ref:`category`») or an :ref:`anti-rigid <rigidity>` type. Therefore, only :ref:`mixins <mixin>>` and :ref:`categories <category>>` can be ancestor of other mixins." .

