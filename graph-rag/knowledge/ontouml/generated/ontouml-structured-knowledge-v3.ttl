<https://w3id.org/ontouml/knowledge#constraint/phasemixin-c2> a ok:Constraint ;
    rdfs:label "PhaseMixin C2" ;
    skos:definition "A «phasemixin» aggregate individuals that follow different identity principles, therefore it may not have a sortal type as ancestor. «kind», «quantity», «collective», «subkind», «role», «phase», «relator», «mode», «quality» are all forbidden." ;
    prov:wasDerivedFrom <urn:ontouml:source:classes/nonsortals/phasemixin/constraints.rst> ;
